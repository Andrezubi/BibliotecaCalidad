@using FrontEnd.Services
@inject AuthSessionService AuthSession

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Biblioteca Virtual</title>

    <script type="importmap"></script>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Estilos globales -->
    <link rel="stylesheet"
          href="~/css/global.css"
          asp-append-version="true" />

    <!-- Estilos propios -->
    <link rel="stylesheet"
          href="~/css/style.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FrontEnd.styles.css"
          asp-append-version="true" />

</head>


<body>

    @if (AuthSession.IsAuthenticated)
        {
            <!-- =========================================
            NAVBAR USUARIO AUTENTICADO
            ========================================== -->

            <header>

                <nav class="navbar navbar-expand-lg main-navbar">

                    <div class="container">

                        <!-- LOGO -->
                        <a class="navbar-brand"
                        asp-area=""
                        asp-page="/Index">

                            <div class="brand-icon">
                                <i class="bi bi-book"></i>
                            </div>

                            <div class="brand-text">

                                <strong>
                                    Biblioteca<span>Virtual</span>
                                </strong>

                                <small>
                                    Tu biblioteca, siempre contigo
                                </small>

                            </div>

                        </a>


                        <!-- BOTÓN MOBILE -->

                        <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Abrir navegación">

                            <span class="navbar-toggler-icon"></span>

                        </button>


                        <!-- NAVIGATION -->

                        <div class="collapse navbar-collapse"
                        id="mainNavbar">


                            <ul class="navbar-nav mx-auto">

                                <li class="nav-item">

                                    <a class="nav-link"
                                    asp-area=""
                                    asp-page="/Index">

                                        Inicio

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                    asp-area=""
                                    asp-page="/Books/Index">

                                        Libros

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                    asp-area=""
                                    asp-page="/Categories/Index">

                                        Categorías

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                    asp-area=""
                                    asp-page="/Authors/Index">

                                        Autores

                                    </a>

                                </li>

                                @if (AuthSession.HasAnyRole("Admin", "Librarian"))
                                {
                                <li class="nav-item">

                                <a class="nav-link"
                                   asp-area=""
                                   asp-page="/Books/Loaned">

                                    Libros prestados

                                </a>

                                </li>
                            }
                            

                        </ul>


                        <!-- USUARIO -->

                        <div class="navbar-actions">

                            <span class="user-welcome">

                                <i class="bi bi-person-circle"></i>

                                Hola,
                                @Context.Session.GetString("Username")

                            </span>


                            <a class="btn btn-login"
                               asp-page="/Auth/Logout">

                                <i class="bi bi-box-arrow-right me-1"></i>

                                Cerrar sesión

                            </a>

                        </div>

                    </div>

                </div>

            </nav>

        </header>
    }
    else
    {
        <!-- =========================================
             NAVBAR USUARIO NO AUTENTICADO
        ========================================== -->

        <header>

            <nav class="navbar navbar-expand-lg main-navbar">

                <div class="container">

                    <!-- LOGO -->

                    <a class="navbar-brand"
                       asp-area=""
                       asp-page="/Index">

                        <div class="brand-icon">
                            <i class="bi bi-book"></i>
                        </div>

                        <div class="brand-text">

                            <strong>
                                Biblioteca<span>Virtual</span>
                            </strong>

                            <small>
                                Tu biblioteca, siempre contigo
                            </small>

                        </div>

                    </a>


                    <!-- MOBILE -->

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Abrir navegación">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <!-- NAVIGATION -->

                    <div class="collapse navbar-collapse"
                         id="mainNavbar">


                        <ul class="navbar-nav mx-auto">

                            

                        </ul>


                        <!-- ACCIONES -->

                        <div class="navbar-actions">

                            <a class="btn btn-login"
                               asp-page="/Auth/Login">

                                <i class="bi bi-person me-1"></i>

                                Iniciar sesión

                            </a>


                            <a class="btn btn-success"
                               asp-page="/Auth/Register">

                                <i class="bi bi-person-plus me-1"></i>

                                Registrarse

                            </a>

                        </div>

                    </div>

                </div>

            </nav>

        </header>
    }


    <!-- =========================================
         CONTENIDO
    ========================================== -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =========================================
         FOOTER
    ========================================== -->

    <footer class="main-footer">

        <div class="container">

            <div class="row g-5">


                <!-- INFORMACIÓN -->

                <div class="col-lg-4">

                    <a class="footer-brand"
                       asp-page="/Index">

                        <div class="brand-icon">

                            <i class="bi bi-book"></i>

                        </div>

                        <div class="brand-text">

                            <strong>
                                Biblioteca<span>Virtual</span>
                            </strong>

                            <small>
                                Tu biblioteca, siempre contigo
                            </small>

                        </div>

                    </a>


                    <p class="footer-description">

                        Una biblioteca virtual pensada para acercarte
                        al mundo de la lectura de una manera sencilla,
                        moderna y accesible.

                    </p>

                </div>


                <!-- BIBLIOTECA -->

                <div class="col-6 col-lg-2">

                    <h5>Biblioteca</h5>

                    <ul>

                        <li>

                            <a asp-page="/Books/Index">
                                Libros
                            </a>

                        </li>

                        <li>

                            <a asp-page="/Categories/Index">
                                Categorías
                            </a>

                        </li>

                        <li>

                            <a asp-page="/Authors/Index">
                                Autores
                            </a>

                        </li>

                    </ul>

                </div>


                <!-- CUENTA -->

                <div class="col-6 col-lg-2">

                    <h5>Cuenta</h5>

                    <ul>

                        @if (Context.Session.GetString("AuthToken") != null)
                        {
                            <li>

                                <a asp-page="/Books/Loaned">
                                    Libros prestados
                                </a>

                            </li>

                            <li>

                                <a asp-page="/Auth/Logout">
                                    Cerrar sesión
                                </a>

                            </li>
                        }
                        else
                        {
                            <li>

                                <a asp-page="/Auth/Login">
                                    Iniciar sesión
                                </a>

                            </li>

                            <li>

                                <a asp-page="/Auth/Register">
                                    Registrarse
                                </a>

                            </li>
                        }

                    </ul>

                </div>


                <!-- INFORMACIÓN -->

                <div class="col-lg-4">

                    <h5>Biblioteca Virtual</h5>

                    <p>

                        Descubre nuevos libros, autores y categorías
                        desde cualquier lugar.

                    </p>


                    <div class="social-links">

                        <a href="#"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>

                        <a href="#"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>

                        <a href="#"
                           aria-label="Twitter">

                            <i class="bi bi-twitter-x"></i>

                        </a>

                    </div>

                </div>

            </div>


            <hr />


            <div class="footer-bottom">

                <span>
                    © 2026 - Biblioteca Virtual
                </span>

                <div>

                    <a href="#">
                        Términos de uso
                    </a>

                    <a href="#">
                        Política de privacidad
                    </a>

                </div>

            </div>

        </div>

    </footer>


    <!-- =========================================
         SCRIPTS
    ========================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>