@page
@model FrontEnd.Pages.Users.RegisterModel

@{
    ViewData["Title"] = "Registrar usuario";
}

<div class="row justify-content-center">

    <div class="col-md-7">

        <h1 class="mb-4">Registrar usuario</h1>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                @Model.SuccessMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row">

                <div class="col-md-8 mb-3">

                    <label asp-for="UserData.CI"
                           class="form-label">
                        CI
                    </label>

                    <input asp-for="UserData.CI"
                           class="form-control" />

                    <span asp-validation-for="UserData.CI"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="UserData.Complement"
                           class="form-label">
                        Complemento
                    </label>

                    <input asp-for="UserData.Complement"
                           class="form-control" />

                    <span asp-validation-for="UserData.Complement"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="mb-3">

                <label asp-for="UserData.FirstName"
                       class="form-label">
                    Nombre
                </label>

                <input asp-for="UserData.FirstName"
                       class="form-control" />

                <span asp-validation-for="UserData.FirstName"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="UserData.LastName"
                       class="form-label">
                    Apellido
                </label>

                <input asp-for="UserData.LastName"
                       class="form-control" />

                <span asp-validation-for="UserData.LastName"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="UserData.Phone"
                       class="form-label">
                    Teléfono
                </label>

                <input asp-for="UserData.Phone"
                       class="form-control" />

                <span asp-validation-for="UserData.Phone"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="UserData.Username"
                       class="form-label">
                    Nombre de usuario
                </label>

                <input asp-for="UserData.Username"
                       class="form-control" />

                <span asp-validation-for="UserData.Username"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="UserData.Password"
                       class="form-label">
                    Contraseña
                </label>

                <input asp-for="UserData.Password"
                       type="password"
                       class="form-control" />

                <span asp-validation-for="UserData.Password"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="btn btn-primary">

                Registrar usuario

            </button>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}