                                        <!-- EDITAR -->

                                        <a asp-page="Update"
                                           asp-route-id="@book.Id"
                                           class="btn btn-warning btn-sm me-1"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- ELIMINAR -->

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                title="Eliminar"
                                                data-bs-toggle="modal"
