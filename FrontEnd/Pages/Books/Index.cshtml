@page
@model FrontEnd.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-5">Catálogo de Libros</h1>
        <p class="text-muted">Consulta y gestiona los libros de la biblioteca.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
            <strong>✓</strong> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
            <strong>⚠</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtro -->
    <form method="get" class="row justify-content-center mb-4">
        <div class="col-auto">
            <div class="form-check form-switch fs-5">
                <input class="form-check-input" type="checkbox" asp-for="OnlyAvailable" id="filterAvailable" onchange="this.form.submit()">
                <label class="form-check-label" for="filterAvailable">
                    Mostrar únicamente libros disponibles
                </label>
            </div>
        </div>
    </form>

    <!-- Tabla -->
    @if (Model.Books == null || !Model.Books.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No se encontraron libros disponibles en este momento.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Título</th>
                        <th>ISBN</th>
                        <th>Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td class="fw-bold">@book.Title</td>
                            <td>@book.Isbn</td>
                            <td>
                                @if (book.IsAvailable)
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No disponible</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (book.IsAvailable)
                                {
                                    <form method="post" asp-page-handler="Loan" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@book.Id" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            Prestar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled>
                                        No disponible
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>