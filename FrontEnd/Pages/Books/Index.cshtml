@page
@model FrontEnd.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Libros";
}

<div class="container content-wrapper">

    <div class="card-custom">

        <!-- ===================================================== -->
        <!-- ENCABEZADO -->
        <!-- ===================================================== -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="page-title mb-1">
                    <i class="bi bi-book me-2"></i>
                    Lista de Libros
                </h2>

                <p class="text-muted mb-0">
                    Administración de libros registrados
                </p>
            </div>

            <a asp-page="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-2"></i>
                Nuevo Libro

            </a>

        </div>


        <!-- ===================================================== -->
        <!-- MENSAJE DE ÉXITO -->
        <!-- ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- MENSAJE DE ERROR -->
        <!-- ===================================================== -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-triangle me-2"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- FILTROS DE BÚSQUEDA -->
        <!-- ===================================================== -->

        <div class="card mb-4 p-3">

            <form method="get">

                <div class="row g-3">

                    <!-- TÍTULO -->

                    <div class="col-md-6">

                        <label asp-for="Title"
                               class="form-label">
                            Título
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Buscar por título..." />

                    </div>


                    <!-- AUTOR -->

                    <div class="col-md-6">

                        <label asp-for="Author"
                               class="form-label">
                            Autor
                        </label>

                        <input asp-for="Author"
                               class="form-control"
                               placeholder="Buscar por autor..." />

                    </div>


                    <!-- CATEGORÍA -->

                    <div class="col-md-4">

                        <label asp-for="Category"
                               class="form-label">
                            Categoría
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Buscar por categoría..." />

                    </div>


                    <!-- ISBN -->

                    <div class="col-md-4">

                        <label asp-for="ISBN"
                               class="form-label">
                            ISBN
                        </label>

                        <input asp-for="ISBN"
                               class="form-control"
                               placeholder="Buscar por ISBN..." />

                    </div>


                    <!-- EDITORIAL -->

                    <div class="col-md-4">

                        <label asp-for="Publisher"
                               class="form-label">
                            Editorial
                        </label>

                        <input asp-for="Publisher"
                               class="form-control"
                               placeholder="Buscar por editorial..." />

                    </div>


                    <!-- DISPONIBILIDAD -->

                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="OnlyAvailable"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="OnlyAvailable"
                                   class="form-check-label">

                                Mostrar solo libros disponibles

                            </label>

                        </div>

                    </div>

                </div>


                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a asp-page="./Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-2"></i>
                        Limpiar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-2"></i>
                        Buscar

                    </button>

                </div>

            </form>

        </div>


        <!-- ===================================================== -->
        <!-- LISTA DE LIBROS -->
        <!-- ===================================================== -->
        @if (Model.Books != null && Model.Books.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th class="text-center">
                                Portada
                            </th>

                            <th>
                                Título
                            </th>

                            <th class="text-center">
                                Edición
                            </th>

                            <th class="text-center">
                                ISBN
                            </th>

                            <th class="text-center">
                                Año
                            </th>

                            <th>
                                Editorial
                            </th>

                            <th class="text-center">
                                Páginas
                            </th>

                            <th class="text-center">
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var book in Model.Books)
                        {
                            <tr>

                                <!-- PORTADA -->

                                <td class="text-center">

                                    @if (!string.IsNullOrWhiteSpace(book.CoverImage))
                                    {
                                        <img src="@book.CoverImage"
                                             alt="Portada de @book.Title"
                                             title="@book.Title"
                                             style="
                                        width:55px;
                                        height:80px;
                                        object-fit:cover;
                                        border-radius:6px;
                                        border:1px solid #ddd;
                                        " />
                                    }
                                    else
                                    {
                                        <div style="
                                            width:55px;
                                            height:80px;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            margin:auto;
                                            background:#f1f1f1;
                                            border-radius:6px;
                                            border:1px solid #ddd;
                                            ">

                                            <i class="bi bi-image text-muted"></i>

                                        </div>
                                    }

                                </td>


                                <!-- TÍTULO -->

                                <td>

                                    <strong>
                                        @book.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(book.Description))
                                    {
                                        <br />

                                        <small class="text-muted">

                                            @(book.Description.Length > 80
                                                ? book.Description[..80] + "..."
                                                : book.Description)

                                        </small>
                                    }

                                </td>


                                <!-- EDICIÓN -->

                                <td class="text-center">

                                    @(book.EditionNumber?.ToString() ?? "-")

                                </td>


                                <!-- ISBN -->

                                <td class="text-center">

                                    @(string.IsNullOrWhiteSpace(book.ISBN)
                                        ? "-"
                                        : book.ISBN)

                                </td>


                                <!-- AÑO -->

                                <td class="text-center">

                                    @(book.PublicationYear?.ToString() ?? "-")

                                </td>


                                <!-- EDITORIAL -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(book.Publisher)
                                        ? "-"
                                        : book.Publisher)

                                </td>


                                <!-- PÁGINAS -->

                                <td class="text-center">

                                    @(book.PageCount?.ToString() ?? "-")

                                </td>


                                <!-- ESTADO -->

                                <td class="text-center">

                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->

                                <td class="text-center">

                                    <!-- PRESTAR -->
                                    @if (book.IsActive)
                                    {
                                        <button type="button"
                                                class="btn btn-primary btn-sm me-1"
                                                title="Prestar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#loanModal"
                                                data-book-id="@book.Id"
                                                data-book-title="@book.Title">

                                            <i class="bi bi-box-arrow-up"></i>

                                        </button>
                                        <button type="button"
                                                class="btn btn-info btn-sm text-white"
                                                title="Agregar copia"
                                                data-bs-toggle="modal"
                                                data-bs-target="#addCopyModal"
                                                data-book-id="@book.Id"
                                                data-book-title="@book.Title">
                                            <i class="bi bi-plus-square"></i>
                                        </button>


                                        <!-- EDITAR -->

                                        <a asp-page="Update"
                                           asp-route-id="@book.Id"
                                           class="btn btn-warning btn-sm me-1"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- ELIMINAR -->

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                title="Eliminar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-book-id="@book.Id"
                                                data-book-title="@book.Title">

                                            <i class="bi bi-trash"></i>

                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- ================================================= -->
            <!-- SIN RESULTADOS -->
            <!-- ================================================= -->

            <div class="text-center py-5">

                <i class="bi bi-book display-1 text-secondary"></i>

                <h4 class="mt-3">
                    No existen libros registrados.
                </h4>

                @if (!string.IsNullOrWhiteSpace(Model.Title) ||
                     !string.IsNullOrWhiteSpace(Model.Author) ||
                     !string.IsNullOrWhiteSpace(Model.Category) ||
                     !string.IsNullOrWhiteSpace(Model.ISBN) ||
                     !string.IsNullOrWhiteSpace(Model.Publisher) ||
                     Model.OnlyAvailable)
                {
                    <p class="text-muted">

                        No se encontraron libros que coincidan
                        con los criterios de búsqueda.

                    </p>

                    <a asp-page="./Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-counterclockwise me-2"></i>
                        Limpiar búsqueda

                    </a>
                }
                else
                {
                    <p class="text-muted">

                        Presione <strong>Nuevo Libro</strong>
                        para registrar uno.

                    </p>

                    <a asp-page="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-2"></i>
                        Nuevo Libro

                    </a>
                }

            </div>
        }

    </div>

</div>


<!-- ===================================================== -->
<!-- MODAL PRÉSTAMO -->
<!-- ===================================================== -->

<div class="modal fade"
     id="loanModal"
     tabindex="-1"
     aria-labelledby="loanModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="loanModalLabel">

                    <i class="bi bi-box-arrow-up me-2"></i>
                    Confirmar préstamo

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>


            <div class="modal-body">

                <p class="mb-0">

                    ¿Deseas marcar como
                    <strong>prestado</strong>
                    el libro

                    <strong id="loanBookTitle"></strong>?

                </p>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <form method="post"
                      asp-page-handler="Loan">

                    <input type="hidden"
                           name="bookId"
                           id="loanBookId" />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Confirmar préstamo

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- MODAL ELIMINACIÓN -->
<!-- ===================================================== -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deleteModalLabel">

                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                    Confirmar eliminación

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>


            <div class="modal-body">

                <p class="mb-2">

                    ¿Está seguro de que desea eliminar este libro?

                </p>

                <p class="fw-bold mb-2"
                   id="deleteBookTitle">
                </p>

                <small class="text-muted">

                    El libro será marcado como inactivo.

                </small>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <form method="post"
                      asp-page-handler="Delete">

                    <input type="hidden"
                           name="id"
                           id="deleteBookId" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Eliminar

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

< !--Modal agregar copia-- >
    <div class="modal fade" id="addCopyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="AddCopy">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-plus-square me-2"></i>
                            Agregar copia
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <p class="mb-3">
                            Nueva copia de <strong id="copyBookTitle"></strong>.
                        </p>

                        <input type="hidden" name="bookId" id="copyBookId" />

                        <label for="internalCode" class="form-label">Código interno</label>
                        <input type="text" name="internalCode" id="internalCode"
                               class="form-control" maxlength="50" required
                               placeholder="Ej: COPY-XXX-001" />
                        <div class="form-text">Debe ser único. Máximo 50 caracteres.</div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Agregar copia
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- MODAL AGREGAR COPIA -->
    <!-- ===================================================== -->
    <div class="modal fade" id="addCopyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="AddCopy">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-plus-square me-2"></i>
                            Agregar copia
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <p class="mb-3">Nueva copia de <strong id="copyBookTitle"></strong>.</p>
                        <input type="hidden" name="bookId" id="copyBookId" />
                        <label for="internalCode" class="form-label">Código interno</label>
                        <input type="text" name="internalCode" id="internalCode"
                               class="form-control" maxlength="50" required
                               placeholder="Ej: COPY-XXX-001" />
                        <div class="form-text">Debe ser único. Máximo 50 caracteres.</div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Agregar copia
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>


    <!-- ===================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================================== -->
    @section Scripts {

        <script>

            document.addEventListener("DOMContentLoaded", function() {

                const loanModal = document.getElementById("loanModal");
                if (loanModal) {
                    loanModal.addEventListener("show.bs.modal", function(event) {
                        const button = event.relatedTarget;
                        document.getElementById("loanBookId").value = button.getAttribute("data-book-id");
                        document.getElementById("loanBookTitle").textContent = button.getAttribute("data-book-title");
                    });
                }

                const addCopyModal = document.getElementById("addCopyModal");
                if (addCopyModal) {
                    addCopyModal.addEventListener("show.bs.modal", function(event) {
                        const button = event.relatedTarget;
                        document.getElementById("copyBookId").value = button.getAttribute("data-book-id");
                        document.getElementById("copyBookTitle").textContent = button.getAttribute("data-book-title");
                        document.getElementById("internalCode").value = "";
                    });
                }

                const deleteModal = document.getElementById("deleteModal");
                if (deleteModal) {
                    deleteModal.addEventListener("show.bs.modal", function(event) {
                        const button = event.relatedTarget;
                        document.getElementById("deleteBookId").value = button.getAttribute("data-book-id");
                        document.getElementById("deleteBookTitle").textContent = button.getAttribute("data-book-title");
                    });
                }

            });

        </script>

    }

      
    }
    );

    }