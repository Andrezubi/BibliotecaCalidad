@page
@model FrontEnd.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Libros";
}

<div class="container content-wrapper">

    <div class="card-custom">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="page-title mb-0">
                <i class="bi bi-book me-2"></i>
                Lista de Libros
            </h2>

            <a asp-page="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-2"></i>
                Nuevo Libro

            </a>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                <i class="bi bi-exclamation-triangle me-2"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }
        <div class="card mb-4 p-3">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">
                            Título
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Buscar por título..." />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label">
                            Autor
                        </label>

                        <input asp-for="Author"
                               class="form-control"
                               placeholder="Buscar por autor..." />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label">
                            Categoría
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Buscar por categoría..." />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ISBN" class="form-label">
                            ISBN
                        </label>

                        <input asp-for="ISBN"
                               class="form-control"
                               placeholder="Buscar por ISBN..." />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Publisher" class="form-label">
                            Editorial
                        </label>

                        <input asp-for="Publisher"
                               class="form-control"
                               placeholder="Buscar por editorial..." />
                    </div>
                    <div class="col-md-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="OnlyAvailable" name="OnlyAvailable" value="true"
                            @(Model.OnlyAvailable ? "checked" : "") />
                            <label class="form-check-label" for="OnlyAvailable">
                                Mostrar solo libros disponibles
                            </label>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a asp-page="./Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-2"></i>
                        Limpiar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-2"></i>
                        Buscar

                    </button>

                </div>

            </form>

        </div>

        @if (Model.Books.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Título</th>

                            <th class="text-center">
                                Edición
                            </th>

                            <th class="text-center">
                                ISBN
                            </th>

                            <th class="text-center">
                                Año
                            </th>

                            <th>
                                Editorial
                            </th>

                            <th class="text-center">
                                Páginas
                            </th>

                            <th class="text-center">
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var book in Model.Books)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @book.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(book.Description))
                                    {
                                        <br />

                                        <small class="text-muted">

                                            @(book.Description.Length > 80
                                                ? book.Description[..80] + "..."
                                                : book.Description)

                                        </small>
                                    }

                                </td>

                                <td class="text-center">
                                    @book.EditionNumber
                                </td>

                                <td class="text-center">
                                    @(string.IsNullOrWhiteSpace(book.ISBN)
                                        ? "-"
                                        : book.ISBN)
                                </td>

                                <td class="text-center">
                                    @(book.PublicationYear?.ToString() ?? "-")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(book.Publisher)
                                        ? "-"
                                        : book.Publisher)
                                </td>

                                <td class="text-center">
                                    @(book.PageCount?.ToString() ?? "-")
                                </td>

                                <td class="text-center">

                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-center">
                                    <form method="post"
                                          asp-page-handler="Loan"
                                          asp-route-bookId="@book.Id"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="btn btn-primary btn-sm me-1"
                                                title="Prestar"
                                                onclick="return confirm('¿Marcar este libro como prestado?');">
                                            <i class="bi bi-box-arrow-up"></i>
                                        </button>

                                    </form>

                                    @if (book.IsActive)
                                    {
                                        <a asp-page="Update"
                                           asp-route-id="@book.Id"
                                           class="btn btn-warning btn-sm me-1"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@book.Id"
                                              style="display:inline;">

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    title="Eliminar"
                                                    onclick="return confirm('¿Desea eliminar este libro?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-book display-1 text-secondary"></i>

                <h4 class="mt-3">
                    No existen libros registrados.
                </h4>

                <p class="text-muted">

                    Presione <strong>Nuevo Libro</strong>
                    para registrar uno.

                </p>

            </div>
        }

    </div>

</div>