@page
@model FrontEnd.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Libros";
}

<div class="container content-wrapper">

    <div class="card-custom">

        <!-- ===================================================== -->
        <!-- ENCABEZADO -->
        <!-- ===================================================== -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="page-title mb-1">
                    <i class="bi bi-book me-2"></i>
                    Lista de Libros
                </h2>

                <p class="text-muted mb-0">
                    Administración de libros registrados
                </p>
            </div>

            <a asp-page="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-2"></i>
                Nuevo Libro

            </a>

        </div>


        <!-- ===================================================== -->
        <!-- MENSAJE DE ÉXITO -->
        <!-- ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- MENSAJE DE ERROR -->
        <!-- ===================================================== -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-triangle me-2"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- FILTROS DE BÚSQUEDA -->
        <!-- ===================================================== -->

        <div class="card mb-4 p-3">

            <form method="get">

                <div class="row g-3">

                    <!-- FRASE -->
                    <div class="col-md-6">

                        <label asp-for="Phrase"
                               class="form-label">
                            Buscar por:
                        </label>

                        <input asp-for="Phrase"
                               class="form-control"
                               placeholder="Buscar por frase..." />

                    </div>

                </div>


                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a asp-page="./Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-2"></i>
                        Limpiar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-2"></i>
                        Buscar

                    </button>

                </div>

            </form>

        </div>


        <!-- ===================================================== -->
        <!-- LISTA DE LIBROS -->
        <!-- ===================================================== -->
        @if (Model.Books != null && Model.Books.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th class="text-center">
                                Portada
                            </th>

                            <th>
                                Título
                            </th>

                            <th class="text-center">
                                Edición
                            </th>

                            <th class="text-center">
                                ISBN
                            </th>

                            <th class="text-center">
                                Año
                            </th>

                            <th>
                                Editorial
                            </th>

                            <th class="text-center">
                                Páginas
                            </th>

                            <th class="text-center">
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var book in Model.Books)
                        {
                            <tr>

                                <!-- PORTADA -->

                                <td class="text-center">

                                    @if (!string.IsNullOrWhiteSpace(book.CoverImage))
                                    {
                                        <img src="@book.CoverImage"
                                             alt="Portada de @book.Title"
                                             title="@book.Title"
                                             style="
                                        width:55px;
                                        height:80px;
                                        object-fit:cover;
                                        border-radius:6px;
                                        border:1px solid #ddd;
                                        " />
                                    }
                                    else
                                    {
                                        <div style="
                                            width:55px;
                                            height:80px;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            margin:auto;
                                            background:#f1f1f1;
                                            border-radius:6px;
                                            border:1px solid #ddd;
                                            ">

                                            <i class="bi bi-image text-muted"></i>

                                        </div>
                                    }

                                </td>


                                <!-- TÍTULO -->

                                <td>

                                    <strong>
                                        @book.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(book.Description))
                                    {
                                        <br />

                                        <small class="text-muted">

                                            @(book.Description.Length > 80
                                                ? book.Description[..80] + "..."
                                                : book.Description)

                                        </small>
                                    }

                                </td>


                                <!-- EDICIÓN -->

                                <td class="text-center">

                                    @(book.EditionNumber?.ToString() ?? "-")

                                </td>


                                <!-- ISBN -->

                                <td class="text-center">

                                    @(string.IsNullOrWhiteSpace(book.ISBN)
                                        ? "-"
                                        : book.ISBN)

                                </td>


                                <!-- AÑO -->

                                <td class="text-center">

                                    @(book.PublicationYear?.ToString() ?? "-")

                                </td>


                                <!-- EDITORIAL -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(book.Publisher)
                                        ? "-"
                                        : book.Publisher)

                                </td>


                                <!-- PÁGINAS -->

                                <td class="text-center">

                                    @(book.PageCount?.ToString() ?? "-")

                                </td>


                                <!-- ESTADO -->

                                <td class="text-center">

                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->

                                <td class="text-center">
