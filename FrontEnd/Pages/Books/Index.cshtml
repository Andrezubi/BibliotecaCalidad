@page
@model FrontEnd.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Libros";
}

<div class="container content-wrapper">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">Libros</h1>
            <p class="text-muted mb-0">
                Administración de libros registrados
            </p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            Registrar libro
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model.Books != null && Model.Books.Any())
    {
        <div class="card-custom">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Portada</th>
                            <th>Título</th>
                            <th>ISBN</th>
                            <th>Edición</th>
                            <th>Año</th>
                            <th>Editorial</th>
                            <th>Páginas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var book in Model.Books)
                        {
                            <tr>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(book.CoverImage))
                                    {
                                        <img src="@book.CoverImage"
                                             alt="Portada de @book.Title"
                                             style="
                                        width: 60px;
                                        height: 85px;
                                        object-fit: cover;
                                        border-radius: 6px;
                                        " />
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin portada
                                        </span>
                                    }
                                </td>

                                <td>
                                    <strong>@book.Title</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(book.ISBN)
                                        ? "-"
                                        : book.ISBN)
                                </td>

                                <td>
                                    @(book.EditionNumber.HasValue
                                        ? book.EditionNumber.ToString()
                                        : "-")
                                </td>

                                <td>
                                    @(book.PublicationYear.HasValue
                                        ? book.PublicationYear.ToString()
                                        : "-")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(book.Publisher)
                                        ? "-"
                                        : book.Publisher)
                                </td>

                                <td>
                                    @(book.PageCount.HasValue
                                        ? book.PageCount.ToString()
                                        : "-")
                                </td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-page="Update"
                                           asp-route-id="@book.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@book.Id"
                                              onsubmit="return confirm('¿Está seguro de eliminar este libro?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Eliminar
                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="card-custom text-center py-5">

            <h4>No hay libros registrados</h4>

            <p class="text-muted">
                Todavía no se ha registrado ningún libro.
            </p>

            <a asp-page="Create"
               class="btn btn-primary">
                Registrar primer libro
            </a>

        </div>
    }

</div>