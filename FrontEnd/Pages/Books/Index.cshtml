                                    @if (book.IsActive)
                                    {
                                        <button type="button"
                                                class="btn btn-primary btn-sm me-1"
                                                title="Prestar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#loanModal"
                                                data-book-id="@book.Id"
                                                data-book-title="@book.Title">

                                            <i class="bi bi-box-arrow-up"></i>

                                        </button>

