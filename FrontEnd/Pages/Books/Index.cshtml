@page
@model FrontEnd.Pages.Books.IndexModel
@using FrontEnd.Services
@inject AuthSessionService AuthSession

@{
    ViewData["Title"] = "Libros";
}

<div class="container content-wrapper">

    <div class="card-custom">

        <!-- ENCABEZADO -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="page-title mb-1">

                    <i class="bi bi-book me-2"></i>

                    Lista de Libros

                </h2>

                <p class="text-muted mb-0">

                    Administración de libros registrados

                </p>

            </div>

            @if (AuthSession.HasAnyRole("Admin", "Librarian"))
            {
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>

                    Nuevo Libro

                </a>
            }

        </div>


        <!-- MENSAJE DE ÉXITO -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }


        <!-- MENSAJE DE ERROR -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }


        <!-- FILTROS DE BÚSQUEDA -->
        <div class="card mb-4 p-3">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Phrase"
                               class="form-label">

                            Buscar por:

                        </label>

                        <input asp-for="Phrase"
                               class="form-control"
                               placeholder="Buscar por título, ISBN, autor, categoría, editorial o descripción..." />

                    </div>

                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-2"></i>

                        Limpiar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-2"></i>

                        Buscar
                    </button>

                </div>

            </form>

        </div>


        <!-- LISTA DE LIBROS -->
        @if (Model.Books != null && Model.Books.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>

                            <th class="text-center">
                                Portada
                            </th>

                            <th>
                                Título
                            </th>

                            <th>
                                Autores
                            </th>

                            <th>
                                Categorías
                            </th>

                            <th class="text-center">
                                Edición
                            </th>

                            <th class="text-center">
                                ISBN
                            </th>

                            <th class="text-center">
                                Año
                            </th>

                            <th>
                                Editorial
                            </th>

                            <th class="text-center">
                                Páginas
                            </th>
                            <th class="text-center">
                                Copias disponibles
                            </th>

                            <th class="text-center">
                                Estado
                            </th>

                            @if (AuthSession.HasAnyRole("Admin", "Librarian"))
                            {
                                <th class="text-center" style="min-width:120px;">Acciones</th>
                            }

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var book in Model.Books)
                        {
                            <tr>

                                <!-- ================================================= -->
                                <!-- PORTADA -->
                                <!-- ================================================= -->

                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(book.CoverImage))
                                    {
                                        <img src="@Model.GetCoverUrl(book.CoverImage)"
                                             alt="Portada de @book.Title"
                                             title="@book.Title"
                                             class="index-book-cover" />
                                    }
                                    else
                                    {
                                        <div class="index-book-no-cover">

                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>

                                <!-- TÍTULO -->
                                <td>
                                    <strong>@book.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(book.Description))
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @(book.Description.Length > 80
                                                ? book.Description[..80] + "..."
                                                : book.Description)
                                        </small>
                                    }
                                </td>


                                <!-- ================================================= -->
                                <!-- AUTORES -->
                                <!-- ================================================= -->

                                <td>

                                    @if (book.AuthorIds != null &&
                                         book.AuthorIds.Any())
                                    {
                                        <div class="index-relations">

                                            @foreach (var authorId in book.AuthorIds)
                                            {
                                                var author =
                                                    Model.Authors.FirstOrDefault(
                                                        a => a.Id == authorId);

                                                if (author != null)
                                                {
                                                    <span class="index-relation-badge">

                                                        <i class="bi bi-person me-1"></i>

                                                        @author.FirstName
                                                        @author.LastName

                                                    </span>
                                                }
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin autor
                                        </span>
                                    }

                                </td>


                                <!-- ================================================= -->
                                <!-- CATEGORÍAS -->
                                <!-- ================================================= -->

                                <td>

                                    @if (book.CategoryIds != null &&
                                         book.CategoryIds.Any())
                                    {
                                        <div class="index-relations">

                                            @foreach (var categoryId in book.CategoryIds)
                                            {
                                                var category =
                                                    Model.Categories.FirstOrDefault(
                                                        c => c.Id == categoryId);

                                                if (category != null)
                                                {
                                                    <span class="index-relation-badge">

                                                        <i class="bi bi-tag me-1"></i>

                                                        @category.Name

                                                    </span>
                                                }
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin categoría
                                        </span>
                                    }

                                </td>


                                <!-- ================================================= -->
                                <!-- EDICIÓN -->
                                <!-- ================================================= -->

                                <td class="text-center">
                                    @(book.EditionNumber?.ToString() ?? "-")
                                </td>

                                <!-- ISBN -->
                                <td class="text-center">
                                    @(string.IsNullOrWhiteSpace(book.ISBN) ? "-" : book.ISBN)
                                </td>

                                <!-- AÑO -->
                                <td class="text-center">
                                    @(book.PublicationYear?.ToString() ?? "-")
                                </td>

                                <!-- EDITORIAL -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(book.Publisher) ? "-" : book.Publisher)
                                </td>

                                <!-- PÁGINAS -->
                                <td class="text-center">
                                    @(book.PageCount?.ToString() ?? "-")
                                </td>

                                <!-- COPIAS DISPONIBLES -->
                                <td class="text-center">
                                    <span class="badge @(book.AvailableCopies > 0 ? "bg-success" : "bg-secondary")">
                                        @book.AvailableCopies
                                    </span>
                                </td>

                                <!-- ================================================= -->
                                <!-- ESTADO -->
                                <!-- ================================================= -->

                                <td class="text-center">
                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>


                                <!-- ================================================= -->
                                <!-- ACCIONES -->
                                <!-- ================================================= -->
                                @if (AuthSession.HasAnyRole("Admin", "Librarian"))
                                {
                                    <td class="text-center">
                                        @if (book.IsActive)
                                        {
                                            <div class="d-inline-grid gap-1" style="grid-template-columns: repeat(2, auto);">

                                                <!-- PRESTAR -->
                                                <button type="button"
                                                        class="btn btn-primary btn-sm"
                                                        title="Prestar"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#loanModal"
                                                        data-book-id="@book.Id"
                                                        data-book-title="@book.Title">
                                                    <i class="bi bi-box-arrow-up"></i>
                                                </button>

                                                <!-- AGREGAR COPIA -->
                                                <button type="button"
                                                        class="btn btn-info btn-sm text-white"
                                                        title="Agregar copia"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#addCopyModal"
                                                        data-book-id="@book.Id"
                                                        data-book-title="@book.Title">
                                                    <i class="bi bi-plus-square"></i>
                                                </button>

                                                <!-- EDITAR -->
                                                <a asp-page="Update"
                                                   asp-route-id="@book.Id"
                                                   class="btn btn-warning btn-sm"
                                                   title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <!-- ELIMINAR -->
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        title="Eliminar"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-book-id="@book.Id"
                                                        data-book-title="@book.Title">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </div>
                                        }
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- SIN RESULTADOS -->
            <div class="text-center py-5">

                <i class="bi bi-book display-1 text-secondary"></i>

                <h4 class="mt-3">No existen libros registrados.</h4>

                @if (!string.IsNullOrWhiteSpace(Model.Phrase))
                {
                    <p class="text-muted">
                        No se encontraron libros que coincidan con los criterios de búsqueda.
                    </p>

                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>

                        Limpiar búsqueda
                    </a>
                }
                else
                {
                    <p class="text-muted">
                        Presione <strong>Nuevo Libro</strong> para registrar uno.
                    </p>

                    @if (AuthSession.HasAnyRole("Admin", "Librarian"))
                    {
                        <a asp-page="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Nuevo Libro
                        </a>
                    }
                }

            </div>
        }

    </div>

</div>


<!-- ========================================================= -->
<!-- MODAL PRÉSTAMO -->
<!-- ===================================================== -->
<div class="modal fade" id="loanModal" tabindex="-1" aria-labelledby="loanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="loanModalLabel">
                    <i class="bi bi-box-arrow-up me-2"></i>

                    Confirmar préstamo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p class="mb-0">
                    ¿Deseas marcar como <strong>prestado</strong> el libro
                    <strong id="loanBookTitle"></strong>?
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                <form method="post" asp-page-handler="Loan">
                    <input type="hidden" name="bookId" id="loanBookId" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>

                        Confirmar préstamo
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>


<!-- ===================================================== -->
<!-- MODAL AGREGAR COPIA -->
<!-- ===================================================== -->
<div class="modal fade" id="addCopyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddCopy">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-square me-2"></i>
                        Agregar copia
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-3">Nueva copia de <strong id="copyBookTitle"></strong>.</p>
                    <input type="hidden" name="bookId" id="copyBookId" />
                    <label for="internalCode" class="form-label">Código interno</label>
                    <input type="text" name="internalCode" id="internalCode"
                           class="form-control" maxlength="50" required
                           placeholder="Ej: COPY-XXX-001" />
                    <div class="form-text">Debe ser único. Máximo 50 caracteres.</div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Agregar copia
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>


<!-- ========================================================= -->
<!-- MODAL ELIMINACIÓN -->
<!-- ===================================================== -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>

                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p class="mb-2">¿Está seguro de que desea eliminar este libro?</p>
                <p class="fw-bold mb-2" id="deleteBookTitle"></p>
                <small class="text-muted">El libro será marcado como inactivo.</small>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" id="deleteBookId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>

                        Eliminar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>


<!-- ========================================================= -->
<!-- ESTILOS ESPECÍFICOS -->
<!-- ========================================================= -->

<style>

    .index-book-cover {
        width: 55px;
        height: 80px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #ddd;
    }

    .index-book-no-cover {
        width: 55px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        background: #f1f1f1;
        border-radius: 6px;
        border: 1px solid #ddd;
    }

    .index-relations {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .index-relation-badge {
        display: inline-block;
        width: fit-content;
        max-width: 220px;
        padding: 5px 9px;
        border-radius: 6px;
        background-color: #f3f1ff;
        color: #5b3cc4;
        font-size: 0.82rem;
        line-height: 1.2;
    }

        .index-relation-badge i {
            font-size: 0.75rem;
        }

    .table th {
        white-space: nowrap;
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }

    @@media (max-width: 1200px) {

        .index-relation-badge {
            max-width: 170px;
            white-space: normal;
        }
    }

</style>


<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->
@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

            const loanModal = document.getElementById("loanModal");
            if (loanModal) {
                loanModal.addEventListener("show.bs.modal", function(event) {
                    const button = event.relatedTarget;
                    document.getElementById("loanBookId").value = button.getAttribute("data-book-id");
                    document.getElementById("loanBookTitle").textContent = button.getAttribute("data-book-title");
                });
            }

            const addCopyModal = document.getElementById("addCopyModal");
            if (addCopyModal) {
                addCopyModal.addEventListener("show.bs.modal", function(event) {
                    const button = event.relatedTarget;
                    document.getElementById("copyBookId").value = button.getAttribute("data-book-id");
                    document.getElementById("copyBookTitle").textContent = button.getAttribute("data-book-title");
                    document.getElementById("internalCode").value = "";
                });
            }

            const deleteModal = document.getElementById("deleteModal");
            if (deleteModal) {
                deleteModal.addEventListener("show.bs.modal", function(event) {
                    const button = event.relatedTarget;
                    document.getElementById("deleteBookId").value = button.getAttribute("data-book-id");
                    document.getElementById("deleteBookTitle").textContent = button.getAttribute("data-book-title");
                });
            }

        });

    </script>

}
