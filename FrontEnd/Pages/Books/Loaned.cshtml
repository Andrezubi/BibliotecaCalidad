@page
@model FrontEnd.Pages.Books.LoanedModel

@{
    ViewData["Title"] = "Libros prestados";
}

<div class="container content-wrapper">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">
                <i class="bi bi-journal-arrow-up me-2"></i>
                Libros prestados
            </h2>
            <a asp-page="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-2"></i>
                Volver a Libros
            </a>
        </div>

        <p class="text-muted">
            Libros que actualmente no se encuentran disponibles.
            Registra su devolución para marcarlos como disponibles y emitir el recibo en caso de multa.
        </p>

        @Html.AntiForgeryToken()

        <div id="alertaExito" class="alert alert-success alert-dismissible fade show d-none" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <span id="mensajeExito"></span>
            <button type="button" class="btn-close" onclick="this.parentElement.classList.add('d-none')"></button>
        </div>

        <div id="alertaError" class="alert alert-danger alert-dismissible fade show d-none" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <span id="mensajeError"></span>
            <button type="button" class="btn-close" onclick="this.parentElement.classList.add('d-none')"></button>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (Model.LoanedBooks.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-check2-circle display-1 text-success"></i>
                <h4 class="mt-3">No hay libros prestados</h4>
                <p class="text-muted">Todos los ejemplares están disponibles.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th class="text-center">Código interno</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.LoanedBooks)
                        {
                            <tr id="fila-@book.CopyId">
                                <td>
                                    <strong>@book.Title</strong>
                                </td>
                                <td class="text-center">
                                    <code>@book.InternalCode</code>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark">
                                        @(book.Status == "Loaned" ? "Prestado" : book.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            onclick="confirmarDevolucion(@book.CopyId, '@book.Title')">
                                        <i class="bi bi-arrow-return-left me-1"></i>
                                        Marcar como disponible
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Comprobante / Recibo -->
<div class="modal fade" id="reciboModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="bi bi-receipt me-2"></i>Recibo de Multa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="location.reload()"></button>
            </div>
            <div class="modal-body p-4" id="areaImpresion">
                <div class="text-center mb-3">
                    <h4 class="fw-bold mb-0">Sistema de Biblioteca</h4>
                    <small class="text-muted">Comprobante de Devolución con Sanción</small>
                </div>
                <hr />
                <div class="row mb-2">
                    <span class="col-6 text-muted">N° Recibo:</span>
                    <strong class="col-6 text-end text-primary" id="reciboNumero">-</strong>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Lector:</span>
                    <span class="col-6 text-end fw-semibold" id="reciboLector">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Libro:</span>
                    <span class="col-6 text-end" id="reciboLibro">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Días de retraso:</span>
                    <span class="col-6 text-end text-danger fw-bold" id="reciboDias">-</span>
                </div>
                <div class="row pt-2 border-top">
                    <span class="col-6 fs-5 fw-bold">Total Pagado:</span>
                    <span class="col-6 fs-5 fw-bold text-end text-success" id="reciboMonto">-</span>
                </div>
                <div class="text-center mt-3 text-muted">
                    <small id="reciboFecha"></small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="location.reload()">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="imprimirRecibo()">
                    <i class="bi bi-printer me-1"></i> Imprimir Recibo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        async function confirmarDevolucion(copyId, titulo) {
            if (!confirm(`¿Confirmar la devolución del libro "${titulo}"?`)) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch(`?handler=Return&copyId=${copyId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();

                if (!response.ok) {
                    mostrarError(data.message || 'No se pudo registrar la devolución.');
                    return;
                }

                if (data.hasFine) {
                    document.getElementById('reciboNumero').innerText = data.receiptNumber || 'N/A';
                    document.getElementById('reciboLector').innerText = data.borrowerName || 'Lector';
                    document.getElementById('reciboLibro').innerText = data.bookTitle || titulo;
                    document.getElementById('reciboDias').innerText = `${data.overdueDays} día(s)`;
                    document.getElementById('reciboMonto').innerText = `Bs. ${Number(data.amount).toFixed(2)}`;
                    document.getElementById('reciboFecha').innerText = data.paidAt ? new Date(data.paidAt).toLocaleString('es-BO') : new Date().toLocaleString('es-BO');

                    const modal = new bootstrap.Modal(document.getElementById('reciboModal'));
                    modal.show();
                } else {
                    mostrarExito(data.message || 'Devolución registrada exitosamente (sin multas).');
                    const fila = document.getElementById(`fila-${copyId}`);
                    if (fila) fila.remove();
                }
            } catch (err) {
                mostrarError('Ocurrió un error inesperado al procesar la devolución.');
            }
        }

        function mostrarExito(mensaje) {
            const alerta = document.getElementById('alertaExito');
            document.getElementById('mensajeExito').innerText = mensaje;
            alerta.classList.remove('d-none');
            document.getElementById('alertaError').classList.add('d-none');
        }

        function mostrarError(mensaje) {
            const alerta = document.getElementById('alertaError');
            document.getElementById('mensajeError').innerText = mensaje;
            alerta.classList.remove('d-none');
            document.getElementById('alertaExito').classList.add('d-none');
        }

        function imprimirRecibo() {
            const contenido = document.getElementById('areaImpresion').innerHTML;
            const ventana = window.open('', '', 'height=550,width=550');
            ventana.document.write('<html><head><title>Recibo de Multa</title>');
            ventana.document.write('<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">');
            ventana.document.write('</head><body class="p-4">');
            ventana.document.write(contenido);
            ventana.document.write('</body></html>');
            ventana.document.close();
            ventana.focus();
            setTimeout(() => { ventana.print(); ventana.close(); }, 300);
        }
    </script>
}