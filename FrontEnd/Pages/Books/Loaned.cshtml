@page
@model FrontEnd.Pages.Books.LoanedModel

@{
    ViewData["Title"] = "Libros prestados";
}

<div class="container content-wrapper">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">
                <i class="bi bi-journal-arrow-up me-2"></i>
                Libros prestados
            </h2>
            <a asp-page="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-2"></i>
                Volver a Libros
            </a>
        </div>

        <p class="text-muted">
            Libros que actualmente no se encuentran disponibles.
            Registra su devolución para marcarlos como disponibles y liquidar multas pendientes.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (Model.LoanedBooks.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-check2-circle display-1 text-success"></i>
                <h4 class="mt-3">No hay libros prestados</h4>
                <p class="text-muted">Todos los ejemplares están disponibles.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th class="text-center">Código interno</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.LoanedBooks)
                        {
                            <tr>
                                <td>
                                    <strong>@book.Title</strong>
                                </td>
                                <td class="text-center">
                                    <code>@book.InternalCode</code>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark">
                                        @(book.Status == "Loaned" ? "Prestado" : book.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form method="post"
                                          asp-page-handler="Return"
                                          asp-route-copyId="@book.CopyId"
                                          style="display:inline;">
                                        <button type="submit"
                                                class="btn btn-success btn-sm"
                                                onclick="return confirm('¿Registrar la devolución del ejemplar @book.InternalCode?');">
                                            <i class="bi bi-arrow-return-left me-1"></i>
                                            Marcar como disponible
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal del Recibo de Multa -->
@if (Model.Receipt != null)
{
    <div class="modal fade" id="reciboModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-receipt me-2"></i>Comprobante de Pago
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4" id="areaImpresion">
                    <div class="text-center mb-3">
                        <h4 class="fw-bold mb-0">Sistema de Biblioteca</h4>
                        <small class="text-muted">Recibo de Devolución con Sanción</small>
                    </div>
                    <hr />
                    <div class="row mb-2">
                        <span class="col-6 text-muted">N° de Recibo:</span>
                        <strong class="col-6 text-end text-primary">@Model.Receipt.ReceiptNumber</strong>
                    </div>
                    <div class="row mb-2">
                        <span class="col-6 text-muted">Lector:</span>
                        <span class="col-6 text-end fw-semibold">@Model.Receipt.BorrowerName</span>
                    </div>
                    <div class="row mb-2">
                        <span class="col-6 text-muted">Libro:</span>
                        <span class="col-6 text-end">@Model.Receipt.BookTitle</span>
                    </div>
                    <div class="row mb-2">
                        <span class="col-6 text-muted">Días de retraso:</span>
                        <span class="col-6 text-end text-danger fw-bold">@Model.Receipt.OverdueDays día(s)</span>
                    </div>
                    <div class="row pt-2 border-top">
                        <span class="col-6 fs-5 fw-bold">Total Pagado:</span>
                        <span class="col-6 fs-5 fw-bold text-end text-success">Bs. @Model.Receipt.Amount.ToString("0.00")</span>
                    </div>
                    <div class="text-center mt-3 text-muted">
                        <small>Fecha: @Model.Receipt.PaidAt?.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" onclick="imprimirRecibo()">
                        <i class="bi bi-printer me-1"></i> Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modal = new bootstrap.Modal(document.getElementById('reciboModal'));
                modal.show();
            });

            function imprimirRecibo() {
                var contenido = document.getElementById('areaImpresion').innerHTML;
                var ventana = window.open('', '', 'height=500,width=500');
                ventana.document.write('<html><head><title>Recibo de Multa</title>');
                ventana.document.write('<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">');
                ventana.document.write('</head><body class="p-4">');
                ventana.document.write(contenido);
                ventana.document.write('</body></html>');
                ventana.document.close();
                ventana.focus();
                setTimeout(() => { ventana.print(); ventana.close(); }, 300);
            }
        </script>
    }
}