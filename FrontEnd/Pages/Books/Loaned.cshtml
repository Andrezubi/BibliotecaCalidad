@page
@model FrontEnd.Pages.Books.LoanedModel

@{
    ViewData["Title"] = "Libros prestados";
}

<div class="container content-wrapper">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">
                <i class="bi bi-journal-arrow-up me-2"></i>
                Libros prestados
            </h2>
            <a asp-page="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-2"></i>
                Volver a Libros
            </a>
        </div>

        <p class="text-muted">
            Libros que actualmente no se encuentran disponibles.
            Para registrar una devolución, acceda al detalle del préstamo correspondiente.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (Model.LoanedBooks.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-check2-circle display-1 text-success"></i>
                <h4 class="mt-3">No hay libros prestados</h4>
                <p class="text-muted">Todos los ejemplares están disponibles.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th class="text-center">Código interno</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.LoanedBooks)
                        {
                            <tr>
                                <td>
                                    <strong>@book.Title</strong>
                                </td>
                                <td class="text-center">
                                    <code>@book.InternalCode</code>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark">
                                        @(book.Status == "Loaned" ? "Prestado" : book.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-page="/Loans/Index" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye me-1"></i>
                                        Ver préstamos
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>