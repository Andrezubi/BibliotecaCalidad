@page
@model FrontEnd.Pages.Books.LoanedModel

@{
    ViewData["Title"] = "Libros prestados";
}

<h1>Libros prestados</h1>

<p>
    Listado de libros que actualmente no se encuentran disponibles.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else if (Model.LoanedBooks.Count == 0)
{
    <div class="alert alert-info">
        No existen libros prestados actualmente.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Código interno</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.LoanedBooks)
            {
                <tr>
                    <td>@book.Title</td>

                    <td>
                        @book.InternalCode
                    </td>

                    <td>
                        @(book.Status == "Loaned"
                            ? "Prestado"
                            : book.Status)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}