@page
@model FrontEnd.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Registrar Libro";
}

<div class="container content-wrapper">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card-custom">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h1 class="page-title mb-1">
                            Registrar Libro
                        </h1>

                        <p class="text-muted mb-0">
                            Complete la información del libro
                        </p>
                    </div>

                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        Volver
                    </a>

                </div>


                <form method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- TÍTULO -->

                    <div class="mb-3">

                        <label asp-for="Book.Title"
                               class="form-label">
                            Título
                        </label>

                        <input asp-for="Book.Title"
                               class="form-control"
                               placeholder="Ingrese el título del libro" />

                        <span asp-validation-for="Book.Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EDICIÓN -->

                    <div class="mb-3">

                        <label asp-for="Book.EditionNumber"
                               class="form-label">
                            Número de edición
                        </label>

                        <input asp-for="Book.EditionNumber"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="Ej. 1" />

                        <span asp-validation-for="Book.EditionNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ISBN -->

                    <div class="mb-3">

                        <label asp-for="Book.ISBN"
                               class="form-label">
                            ISBN
                        </label>

                        <input asp-for="Book.ISBN"
                               class="form-control"
                               placeholder="Ingrese el ISBN" />

                        <span asp-validation-for="Book.ISBN"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- AÑO -->

                    <div class="mb-3">

                        <label asp-for="Book.PublicationYear"
                               class="form-label">
                            Año de publicación
                        </label>

                        <input asp-for="Book.PublicationYear"
                               class="form-control"
                               type="number"
                               min="1000"
                               max="2100"
                               placeholder="Ej. 2024" />

                        <span asp-validation-for="Book.PublicationYear"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EDITORIAL -->

                    <div class="mb-3">

                        <label asp-for="Book.Publisher"
                               class="form-label">
                            Editorial
                        </label>

                        <input asp-for="Book.Publisher"
                               class="form-control"
                               placeholder="Ingrese la editorial" />

                        <span asp-validation-for="Book.Publisher"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PÁGINAS -->

                    <div class="mb-3">

                        <label asp-for="Book.PageCount"
                               class="form-label">
                            Cantidad de páginas
                        </label>

                        <input asp-for="Book.PageCount"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="Ej. 350" />

                        <span asp-validation-for="Book.PageCount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PORTADA -->

                    <div class="mb-3">

                        <label asp-for="Book.CoverImage"
                               class="form-label">
                            Portada del libro
                        </label>

                        <input asp-for="Book.CoverImage"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <div class="form-text">
                            Formatos permitidos: JPG, JPEG, PNG y WEBP.
                            Tamaño máximo: 5 MB.
                        </div>

                        <span asp-validation-for="Book.CoverImage"
                              class="text-danger">
                        </span>

                        <div class="mt-3">

                            <img id="coverPreview"
                                 src="#"
                                 alt="Vista previa de la portada"
                                 style="
                            display:none;
                            max-width:180px;
                            max-height:260px;
                            object-fit:cover;
                            border-radius:8px;
                            " />

                        </div>

                    </div>


                    <!-- DESCRIPCIÓN -->

                    <div class="mb-4">

                        <label asp-for="Book.Description"
                               class="form-label">
                            Descripción
                        </label>

                        <textarea asp-for="Book.Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Ingrese una descripción del libro">
                        </textarea>

                        <span asp-validation-for="Book.Description"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BOTONES -->

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-page="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Registrar libro
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const input =
                document.getElementById("Book_CoverImage");

            const preview =
                document.getElementById("coverPreview");

            if (!input || !preview)
                return;

            input.addEventListener("change", function() {

                const file = input.files[0];

                if (!file) {

                    preview.style.display = "none";
                    preview.removeAttribute("src");

                    return;
                }

                preview.src =
                    URL.createObjectURL(file);

                preview.style.display = "block";

            });

        });

    </script>
}