@page
@model FrontEnd.Pages.Auth.LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<form method="post">

    <div class="mb-3">
        <label asp-for="Login.Username"
               class="form-label">
            Usuario
        </label>

        <input asp-for="Login.Username"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Login.Password"
               class="form-label">
            Contraseña
        </label>

        <input asp-for="Login.Password"
               type="password"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Iniciar sesión
    </button>

    <a asp-page="/Auth/Register"
       class="btn btn-link">
        Crear cuenta
    </a>

</form>