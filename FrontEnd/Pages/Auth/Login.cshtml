@page
@model FrontEnd.Pages.Auth.LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">

    <div class="auth-container">

        <!-- PANEL IZQUIERDO -->
        <div class="auth-info">

            <div class="auth-info-content">

                <div class="auth-brand-icon">
                    <i class="bi bi-book-half"></i>
                </div>

                <span class="auth-label">
                    BIBLIOTECA VIRTUAL
                </span>

                <h1>
                    Bienvenido de nuevo.
                </h1>

                <p>
                    Inicia sesión para continuar disfrutando de tu
                    biblioteca y acceder a todas sus funcionalidades.
                </p>

                <div class="auth-features">

                    <div>
                        <i class="bi bi-book"></i>
                        <span>Explora nuestro catálogo</span>
                    </div>

                    <div>
                        <i class="bi bi-bookmark-check"></i>
                        <span>Consulta tus libros</span>
                    </div>

                    <div>
                        <i class="bi bi-person-check"></i>
                        <span>Gestiona tu cuenta</span>
                    </div>

                </div>

            </div>

        </div>


        <!-- FORMULARIO -->
        <div class="auth-form-container">

            <div class="auth-form">

                <div class="auth-form-header">

                    <div class="auth-mobile-icon">
                        <i class="bi bi-box-arrow-in-right"></i>
                    </div>

                    <h2>
                        Iniciar sesión
                    </h2>

                    <p>
                        Ingresa tus datos para acceder a tu cuenta.
                    </p>

                </div>


                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger auth-alert">

                        <i class="bi bi-exclamation-circle me-2"></i>

                        @Model.ErrorMessage

                    </div>
                }


                <form method="post">

                    <!-- USUARIO -->
                    <div class="auth-field">

                        <label asp-for="Login.Username"
                               class="form-label">

                            Usuario

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                            <input asp-for="Login.Username"
                                   class="form-control"
                                   placeholder="Ingresa tu usuario"
                                   autocomplete="username" />

                        </div>

                        <span asp-validation-for="Login.Username"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONTRASEÑA -->
                    <div class="auth-field">

                        <label asp-for="Login.Password"
                               class="form-label">

                            Contraseña

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Login.Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Ingresa tu contraseña"
                                   autocomplete="current-password" />

                        </div>

                        <span asp-validation-for="Login.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BOTÓN -->
                    <button type="submit"
                            class="btn btn-primary auth-submit">

                        <i class="bi bi-box-arrow-in-right me-2"></i>

                        Iniciar sesión

                    </button>

                </form>


                <!-- REGISTRO -->
                <div class="auth-divider">

                    <span>
                        ¿Todavía no tienes una cuenta?
                    </span>

                </div>

                <a asp-page="/Auth/Register"
                   class="btn btn-outline-primary auth-register">

                    <i class="bi bi-person-plus me-2"></i>

                    Crear una cuenta

                </a>


                <!-- VOLVER -->
                <div class="auth-back">

                    <a asp-page="/Index">

                        <i class="bi bi-arrow-left me-1"></i>

                        Volver al inicio

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}