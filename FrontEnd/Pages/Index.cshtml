@page
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Inicio";

    var authToken = HttpContext.Session.GetString("AuthToken");
    var username = HttpContext.Session.GetString("Username");
    var role = HttpContext.Session.GetString("Role");

    var isAuthenticated = !string.IsNullOrEmpty(authToken);

    var accountLabel = !string.IsNullOrEmpty(role)
        ? role.ToUpper()
        : "TU CUENTA";
}


<!-- =========================================================
     HERO
========================================================= -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7">

                <div class="hero-content">

                    <span class="hero-label">
                        <i class="bi bi-book-half"></i>
                        BIBLIOTECA VIRTUAL
                    </span>

                    <h1 class="hero-title">
                        Descubre historias que
                        <span>merecen ser leídas.</span>
                    </h1>

                    <p class="hero-description">
                        Explora nuestra colección de libros, descubre nuevos
                        autores y encuentra tu próxima lectura favorita.
                        Todo desde un solo lugar.
                    </p>

                    <div class="hero-buttons">

                        <a asp-page="/Books/Index"
                           class="btn btn-primary btn-lg">

                            <i class="bi bi-book me-2"></i>

                            Explorar libros

                        </a>

                        <a asp-page="/Categories/Index"
                           class="btn btn-outline-primary btn-lg">

                            <i class="bi bi-grid-3x3-gap me-2"></i>

                            Ver categorías

                        </a>

                    </div>

                </div>

            </div>


            <!-- ILUSTRACIÓN -->

            <div class="col-lg-5 d-none d-lg-flex">

                <div class="hero-illustration">

                    <div class="hero-circle"></div>

                    <div class="hero-book hero-book-one">

                        <i class="bi bi-book"></i>

                    </div>

                    <div class="hero-book hero-book-two">

                        <i class="bi bi-book-half"></i>

                    </div>

                    <div class="hero-book hero-book-three">

                        <i class="bi bi-journal-bookmark"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURES
========================================================= -->

<section class="section-padding">

    <div class="container">

        <div class="section-heading">

            <span class="section-label">
                TODO LO QUE NECESITAS
            </span>

            <h2>
                Una biblioteca pensada para ti
            </h2>

            <p>
                Encuentra, explora y disfruta de tus libros
                de una manera sencilla.
            </p>

        </div>


        <div class="row g-4">


            <!-- LIBROS -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-book"></i>

                    </div>

                    <h3>
                        Explora libros
                    </h3>

                    <p>
                        Descubre nuestra colección de libros y
                        encuentra nuevas historias para disfrutar.
                    </p>

                    <a asp-page="/Books/Index">

                        Ver libros

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- CATEGORÍAS -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-grid-3x3-gap"></i>

                    </div>

                    <h3>
                        Categorías
                    </h3>

                    <p>
                        Explora diferentes categorías y encuentra
                        libros de acuerdo con tus intereses.
                    </p>

                    <a asp-page="/Categories/Index">

                        Ver categorías

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- AUTORES -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-person-lines-fill"></i>

                    </div>

                    <h3>
                        Conoce autores
                    </h3>

                    <p>
                        Descubre a los autores detrás de las
                        historias que forman nuestra biblioteca.
                    </p>

                    <a asp-page="/Authors/Index">

                        Ver autores

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- CUENTA -->

            <div class="col-md-6 col-lg-3">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-person-circle"></i>

                    </div>


                    @if (isAuthenticated)
                    {
                        <h3>
                            Tu cuenta
                        </h3>

                        <p>
                            Bienvenido,
                            <strong>@username</strong>.
                            Consulta tus libros y continúa
                            explorando nuestra biblioteca.
                        </p>

                        <a asp-page="/Books/Loaned">

                            Mis libros

                            <i class="bi bi-arrow-right"></i>

                        </a>
                    }
                    else
                    {
                        <h3>
                            Tu cuenta
                        </h3>

                        <p>
                            Inicia sesión o crea una cuenta para
                            acceder a las funcionalidades
                            personalizadas de la biblioteca.
                        </p>

                        <a asp-page="/Auth/Login">

                            Iniciar sesión

                            <i class="bi bi-arrow-right"></i>

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     READING SECTION
========================================================= -->

<section class="reading-section">

    <div class="container">

        <div class="row align-items-center">


            <!-- TEXTO -->

            <div class="col-lg-6">

                <div class="reading-content">

                    <span class="section-label">
                        EL PLACER DE LEER
                    </span>

                    <h2>
                        Cada libro abre una
                        nueva puerta.
                    </h2>

                    <p>
                        Leer nos permite conocer nuevos mundos,
                        descubrir diferentes perspectivas y
                        aprender algo nuevo con cada historia.
                    </p>

                    <p>
                        Nuestra biblioteca está pensada para que
                        puedas encontrar fácilmente los libros
                        que buscas y descubrir otros que quizás
                        nunca habías considerado.
                    </p>

                    <a asp-page="/Books/Index"
                       class="btn btn-primary">

                        <i class="bi bi-book me-2"></i>

                        Explorar colección

                    </a>

                </div>

            </div>


            <!-- VISUAL -->

            <div class="col-lg-6">

                <div class="reading-visual">

                    <div class="reading-card reading-card-back">

                        <i class="bi bi-book"></i>

                    </div>

                    <div class="reading-card reading-card-middle">

                        <i class="bi bi-journal-text"></i>

                    </div>

                    <div class="reading-card reading-card-front">

                        <div class="reading-card-icon">

                            <i class="bi bi-book-half"></i>

                        </div>

                        <span>
                            Tu próxima historia
                        </span>

                        <strong>
                            comienza aquí.
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     STATISTICS
========================================================= -->

<section class="stats-section">

    <div class="container">

        <div class="row g-4 text-center">


            <!-- LIBROS -->

            <div class="col-6 col-md-3">

                <div class="stat-item">

                    <div class="stat-icon">

                        <i class="bi bi-book"></i>

                    </div>

                    <div class="stat-number">

                        <i class="bi bi-plus"></i>

                    </div>

                    <p>
                        Libros disponibles
                    </p>

                </div>

            </div>


            <!-- LECTORES -->

            <div class="col-6 col-md-3">

                <div class="stat-item">

                    <div class="stat-icon">

                        <i class="bi bi-people"></i>

                    </div>

                    <div class="stat-number">

                        <i class="bi bi-plus"></i>

                    </div>

                    <p>
                        Lectores registrados
                    </p>

                </div>

            </div>


            <!-- AUTORES -->

            <div class="col-6 col-md-3">

                <div class="stat-item">

                    <div class="stat-icon">

                        <i class="bi bi-person-lines-fill"></i>

                    </div>

                    <div class="stat-number">

                        <i class="bi bi-plus"></i>

                    </div>

                    <p>
                        Autores
                    </p>

                </div>

            </div>


            <!-- CATEGORÍAS -->

            <div class="col-6 col-md-3">

                <div class="stat-item">

                    <div class="stat-icon">

                        <i class="bi bi-grid-3x3-gap"></i>

                    </div>

                    <div class="stat-number">

                        <i class="bi bi-plus"></i>

                    </div>

                    <p>
                        Categorías
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="cta-section">

    <div class="container">

        <div class="cta-card">


            <!-- CONTENIDO -->

            <div class="cta-content">

                @if (isAuthenticated)
                {
                    <span class="section-label">
                        @accountLabel
                    </span>

                    <h2>
                        ¡Hola, @username!
                    </h2>

                    <p>
                        Continúa explorando nuestra biblioteca y
                        descubre nuevas historias para disfrutar.
                    </p>

                    <div class="cta-buttons">

                        <a asp-page="/Books/Index"
                           class="btn btn-primary">

                            <i class="bi bi-book me-2"></i>

                            Ver libros

                        </a>

                        <a asp-page="/Books/Loaned"
                           class="btn btn-outline-primary">

                            <i class="bi bi-bookmark-check me-2"></i>

                            Mis libros

                        </a>

                    </div>
                }
                else
                {
                    <span class="section-label">
                        COMIENZA AHORA
                    </span>

                    <h2>
                        Tu próxima gran lectura
                        te está esperando.
                    </h2>

                    <p>
                        Crea una cuenta y disfruta de todas las
                        funcionalidades de nuestra biblioteca virtual.
                    </p>

                    <div class="cta-buttons">

                        <a asp-page="/Auth/Register"
                           class="btn btn-primary">

                            <i class="bi bi-person-plus me-2"></i>

                            Crear una cuenta

                        </a>

                        <a asp-page="/Auth/Login"
                           class="btn btn-outline-primary">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Iniciar sesión

                        </a>

                    </div>
                }

            </div>


            <!-- DECORACIÓN -->

            <div class="cta-decoration">

                <div class="cta-circle"></div>

                <div class="cta-book">

                    <i class="bi bi-book-half"></i>

                </div>

            </div>

        </div>

    </div>

</section>