@page
@model FrontEnd.Pages.Loans.CreateModel
@{
    ViewData["Title"] = "Crear Préstamo";
}

<h1>Crear Préstamo</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="mb-3">
        <label for="borrower" class="form-label">Lector</label>
        <select asp-for="SelectedBorrowerId" class="form-select" id="borrower">
            <option value="0">-- Seleccione --</option>
            @foreach (var b in Model.Borrowers)
            {
                <option value="@b.Id">@b.FirstName @b.LastName (@b.Username)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Libros</label>
        <div>
            @foreach (var book in Model.Books)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedBookIds" value="@book.Id" id="book_@book.Id" />
                    <label class="form-check-label" for="book_@book.Id">@book.Title</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Crear préstamo</button>
    <a asp-page="/Loans/Index" class="btn btn-secondary">Cancelar</a>
</form>
