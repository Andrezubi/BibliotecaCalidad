@page "{id}"
@model FrontEnd.Pages.Loans.DetailsModel
@inject FrontEnd.Services.FinePaymentIdProtector PaymentIdProtector

@{
    ViewData["Title"] = "Detalle de Préstamo";
}

<!-- Vista previa de multa ANTES de confirmar la devolución: NO es un recibo de pago. -->
<div class="modal fade" id="reciboModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-circle me-2"></i>Vista previa de multa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="location.reload()"></button>
            </div>
            <div class="modal-body p-4" id="areaImpresion">
                <div class="text-center mb-3">
                    <h4 class="fw-bold mb-0">Sistema de Biblioteca</h4>
                    <small class="text-muted">Estimación antes de confirmar la devolución</small>
                </div>
                <hr />
                <div class="row mb-2">
                    <span class="col-6 text-muted">Lector:</span>
                    <span class="col-6 text-end fw-semibold" id="reciboLector">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Libro:</span>
                    <span class="col-6 text-end" id="reciboLibro">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Días de retraso:</span>
                    <span class="col-6 text-end text-danger fw-bold" id="reciboDias">-</span>
                </div>
                <div class="row pt-2 border-top">
                    <span class="col-6 fs-5 fw-bold">Multa estimada:</span>
                    <span class="col-6 fs-5 fw-bold text-end text-danger" id="reciboMonto">-</span>
                </div>
                <div class="text-center mt-3 text-muted">
                    <small>Esta vista previa no representa un pago. El recibo PDF solo se emite después del cobro.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="location.reload()">Cerrar</button>
                <button type="button" class="btn btn-success" id="confirmReturnBtn" style="display:none;" onclick="confirmReturn()">
                    <i class="bi bi-check2-circle me-1"></i> Confirmar Devolución
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Called from the return button next to each loan item
        window.returnCopy = async function(copyId, titulo) {
            console.log('returnCopy called', copyId, titulo);
            if (!confirm('¿Confirmar la devolución del libro "' + titulo + '"?')) {
                return;
            }

            try {
                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                // Step 1: Preview - check if there will be a fine (confirm=false)
                const previewUrl = window.location.pathname + '?handler=ReturnItem&confirm=false';
                const formData = new FormData();
                formData.append('copyId', copyId);
                if (token) formData.append('__RequestVerificationToken', token);

                const previewResponse = await fetch(previewUrl, {
                    method: 'POST',
                    body: formData
                });

                if (!previewResponse.ok) {
                    let errorMsg = 'Error desconocido';
                    try {
                        const errorData = await previewResponse.json();
                        errorMsg = errorData.message || errorData.title || JSON.stringify(errorData);
                    } catch {
                        const txt = await previewResponse.text();
                        errorMsg = txt || `HTTP ${previewResponse.status}`;
                    }
                    alert('Error: ' + errorMsg);
                    console.error('Return preview failed:', errorMsg);
                    return;
                }

                const previewData = await previewResponse.json();

                if (previewData.hasFine) {
                    // Show fine modal with confirm button
                    document.getElementById('reciboLector').innerText = previewData.borrowerName ?? '-';
                    document.getElementById('reciboLibro').innerText = previewData.bookTitle ?? '-';
                    document.getElementById('reciboDias').innerText = previewData.overdueDays ?? '-';
                    document.getElementById('reciboMonto').innerText = 'Bs. ' + Number(previewData.amount).toFixed(2);

                    const confirmBtn = document.getElementById('confirmReturnBtn');
                    confirmBtn.style.display = 'inline-block';
                    confirmBtn.dataset.copyId = copyId;
                    const modal = new bootstrap.Modal(document.getElementById('reciboModal'));
                    modal.show();
                } else {
                    // No fine - confirm directly (persist)
                    await confirmReturnDirect(copyId);
                }
            } catch (err) {
                alert('Ocurrió un error inesperado al procesar la devolución: ' + err.message);
                console.error('Return error:', err);
            }
        }

        // Direct confirmation without fine (or after user clicks confirm in modal)
        async function confirmReturnDirect(copyId) {
            try {
                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                const formData = new FormData();
                formData.append('copyId', copyId);
                if (token) formData.append('__RequestVerificationToken', token);

                const url = window.location.pathname + '?handler=ReturnItem&confirm=true';

                const response = await fetch(url, { method: 'POST', body: formData });

                if (!response.ok) {
                    let errorMsg = 'Error desconocido';
                    try {
                        const errorData = await response.json();
                        errorMsg = errorData.message || errorData.title || JSON.stringify(errorData);
                    } catch {
                        const txt = await response.text();
                        errorMsg = txt || `HTTP ${response.status}`;
                    }
                    alert('Error al confirmar la devolución: ' + errorMsg);
                    console.error('Return confirm failed:', errorMsg);
                    return;
                }

                const data = await response.json();
                if (data.hasFine) {
                    // This shouldn't happen in direct confirm, but handle it
                    alert('Multa registrada y devolución confirmada.');
                } else {
                    alert(data.message || 'Devolución confirmada.');
                }
                location.reload();
            } catch (e) {
                alert('Error inesperado al confirmar la devolución: ' + e.message);
                console.error('Confirm return error:', e);
            }
        }

        // Called from modal to confirm and persist the return when a fine exists
        async function confirmReturn() {
            try {
                const btn = document.getElementById('confirmReturnBtn');
                const copyId = btn.dataset.copyId;
                await confirmReturnDirect(copyId);
            } catch (e) {
                alert('Error inesperado al confirmar la devolución.');
                console.error(e);
            }
        }
    </script>
}

@Html.AntiForgeryToken()

<div class="container content-wrapper">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="page-title mb-0">
                    <i class="bi bi-journal-text me-2"></i>
                    Detalle de Préstamo
                </h2>
                <p class="text-muted mb-0">
                    Información completa del préstamo y sus ítems
                </p>
            </div>

            <div class="d-flex gap-2">
                @if (Model.Loan != null)
                {
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEditarPrestamo">
                        <i class="bi bi-pencil-square me-2"></i>
                        Modificar Préstamo
                    </button>
                }

                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>
                    Volver a Préstamos
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]
                @if (TempData["PaymentReceiptToken"] is string receiptToken)
                {
                    <a asp-page="/Loans/Index" asp-page-handler="Receipt"
                       asp-route-receipt="@receiptToken" class="btn btn-sm btn-outline-success ms-2">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Descargar recibo PDF
                    </a>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (Model.Loan == null)
        {
            <div class="text-center py-5">
                <i class="bi bi-exclamation-circle display-1 text-warning"></i>
                <h4 class="mt-3">Préstamo no encontrado</h4>
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="border-bottom pb-2">Información del Préstamo</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Lector</dt>
                        <dd class="col-sm-9">@Model.Loan.BorrowerName</dd>

                        <dt class="col-sm-3">Bibliotecario</dt>
                        <dd class="col-sm-9">@Model.Loan.LibrarianName</dd>

                        <dt class="col-sm-3">Fecha de préstamo</dt>
                        <dd class="col-sm-9">@Model.Loan.LoanDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Fecha de vencimiento</dt>
                        <dd class="col-sm-9">
                            <span class="fw-semibold">@Model.Loan.DueDate.ToString("dd/MM/yyyy")</span>
                        </dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">
                            @{
                                var badgeClass = Model.Loan.Status switch
                                {
                                    "Active" => "bg-primary",
                                    "Completed" => "bg-success",
                                    "Overdue" => "bg-danger",
                                    "Lost" => "bg-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass fs-6 px-3 py-2">
                                @Model.Loan.StatusDisplayName
                            </span>
                        </dd>

                        <dt class="col-sm-3">Creado</dt>
                        <dd class="col-sm-9">@Model.Loan.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Actualizado</dt>
                        <dd class="col-sm-9">@(Model.Loan.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h5 class="border-bottom pb-2">Resumen de Ítems</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Total de ítems</dt>
                        <dd class="col-sm-8"><strong>@Model.Loan.Items.Count</strong></dd>

                        <dt class="col-sm-4">Devueltos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">@Model.Loan.Items.Count(i => i.Status == "Returned")</span>
                        </dd>

                        <dt class="col-sm-4">Activos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.Loan.Items.Count(i => i.Status == "Active")</span>
                        </dd>

                        <dt class="col-sm-4">Vencidos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger">@Model.Loan.Items.Count(i => i.Status == "Overdue")</span>
                        </dd>

                        <dt class="col-sm-4">Perdidos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-dark">@Model.Loan.Items.Count(i => i.Status == "Lost")</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <hr />

            <h5 class="mb-3">Ítems del Préstamo</h5>

            @if (Model.Loan.Items.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Este préstamo no tiene ítems registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Copia</th>
                                <th>Libro</th>
                                <th>Estado</th>
                                <th class="text-center">Fecha devolución</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Loan.Items)
                            {
                                <tr>
                                    <td>
                                        <code>@item.InternalCode</code>

                                    </td>
                                    <td>
                                        <strong>@item.BookTitle</strong>

                                    </td>
                                    <td>
                                        @{
                                            var itemBadgeClass = item.Status switch
                                            {
                                                "Active" => "bg-primary",
                                                "Returned" => "bg-success",
                                                "Overdue" => "bg-danger",
                                                "Lost" => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @itemBadgeClass">
                                            @item.StatusDisplayName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @(item.ReturnedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == "Active" || item.Status == "Overdue")
                                        {
                                            <button type="button" class="btn btn-success btn-sm" data-title="@item.BookTitle" onclick="returnCopy(@item.CopyId, this.dataset.title)">
                                                <i class="bi bi-arrow-return-left me-1"></i> Devolver
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Multas reales registradas y estimaciones (sin cobro). -->
            <section id="multas" class="mt-4 pt-3 border-top">
                <h5 class="mb-3"><i class="bi bi-cash-coin me-2"></i>Multas del préstamo</h5>
                @if (!string.IsNullOrEmpty(Model.FineError))
                {
                    <div class="alert alert-warning">@Model.FineError</div>
                }
                else if (Model.FineDetails == null || Model.FineDetails.Fines.Count == 0)
                {
                    <div class="alert alert-info">Este préstamo no tiene multas registradas ni estimadas.</div>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <small class="text-muted">Pendiente de pago</small>
                                <div class="fs-5 fw-bold text-danger">Bs @Model.FineDetails.TotalPending.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <small class="text-muted">Pagado</small>
                                <div class="fs-5 fw-bold text-success">Bs @Model.FineDetails.TotalPaid.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <small class="text-muted">Estimado, aún no registrado</small>
                                <div class="fs-5 fw-bold text-warning">Bs @Model.FineDetails.TotalEstimated.ToString("0.00")</div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Libro</th>
                                    <th>Días hábiles</th>
                                    <th>Tarifa diaria</th>
                                    <th>Multa</th>
                                    <th>Saldo</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fine in Model.FineDetails.Fines)
                                {
                                    <tr>
                                        <td><strong>@fine.BookTitle</strong></td>
                                        <td>@fine.OverdueDays</td>
                                        <td>Bs @fine.DailyRate.ToString("0.00")</td>
                                        <td>Bs @fine.Amount.ToString("0.00")</td>
                                        <td>Bs @fine.PendingAmount.ToString("0.00")</td>
                                        <td>
                                            @if (fine.Status == "Estimated")
                                            {
                                                <span class="badge bg-warning text-dark">Estimación</span>
                                            }
                                            else if (fine.Status == "Waived")
                                            {

                                                <span class="badge bg-secondary">Condonada</span>
                                            }
                                            else if (fine.PendingAmount > 0)
                                            {

                                                <span class="badge bg-danger">Pendiente</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-success">Pagada</span>
                                            }
                                        </td>
                                        <td>
                                            @if (fine.FineId > 0 && fine.PendingAmount > 0)
                                            {
                                                <form method="post" asp-page-handler="PayFine"
                                                      asp-route-id="@Model.Id" class="d-inline"
                                                      onsubmit="return confirm('¿Confirmar el cobro de esta multa?');">
                                                    <input type="hidden" name="fineId" value="@fine.FineId" />
                                                    <button type="submit" class="btn btn-warning btn-sm">
                                                        <i class="bi bi-cash-coin me-1"></i>Pagar multa
                                                    </button>
                                                </form>
                                            }
                                            @foreach (var payment in fine.Payments)
                                            {
                                                <a asp-page="/Loans/Index" asp-page-handler="Receipt"
                                                   asp-route-receipt="@PaymentIdProtector.Protect(payment.PaymentId)"
                                                   class="btn btn-outline-success btn-sm my-1"
                                                   title="@($"Recibo {payment.ReceiptNumber} - {payment.PaidAt:dd/MM/yyyy}")">
                                                    <i class="bi bi-file-earmark-pdf me-1"></i>Recibo PDF
                                                </a>
                                            }
                                            @if (fine.Status == "Estimated")
                                            {
                                                <small class="text-muted d-block">Se registra al devolver el libro.</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <small class="text-muted">
                        Los importes estimados no son deudas cobrables. El PDF se habilita solo después de registrar el pago.
                    </small>
                }
            </section>
        }
    </div>
</div>

<!-- Modal para Modificar Estado y Fecha de Vencimiento -->
@if (Model.Loan != null)
{
    <div class="modal fade" id="modalEditarPrestamo" tabindex="-1" aria-labelledby="modalEditarPrestamoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateLoan">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalEditarPrestamoLabel">
                            <i class="bi bi-calendar-event me-2"></i>Modificar Préstamo
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="EditDueDate" class="form-label fw-semibold">Nueva Fecha de Vencimiento</label>
                            <input asp-for="EditDueDate" type="date" class="form-control" required />
                            <small class="text-muted">Extiende la fecha límite de entrega del libro.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditStatus" class="form-label fw-semibold">Estado del Préstamo</label>
                            <select asp-for="EditStatus" class="form-select" required>
                                <option value="Active">Activo</option>
                                <option value="Completed">Completado</option>
                                <option value="Overdue">Vencido</option>
                                <option value="Lost">Perdido</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}