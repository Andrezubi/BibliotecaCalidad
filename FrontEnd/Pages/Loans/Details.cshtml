@page "{id:int}"
@model FrontEnd.Pages.Loans.DetailsModel

@{
    ViewData["Title"] = "Detalle de Préstamo";
}

<!-- Modal Comprobante / Recibo de Multa -->
<div class="modal fade" id="reciboModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="bi bi-receipt me-2"></i>Recibo de Multa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="location.reload()"></button>
            </div>
            <div class="modal-body p-4" id="areaImpresion">
                <div class="text-center mb-3">
                    <h4 class="fw-bold mb-0">Sistema de Biblioteca</h4>
                    <small class="text-muted">Comprobante de Devolución con Sanción</small>
                </div>
                <hr />
                <div class="row mb-2">
                    <span class="col-6 text-muted">N° Recibo:</span>
                    <strong class="col-6 text-end text-primary" id="reciboNumero">-</strong>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Lector:</span>
                    <span class="col-6 text-end fw-semibold" id="reciboLector">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Libro:</span>
                    <span class="col-6 text-end" id="reciboLibro">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Préstamo:</span>
                    <span class="col-6 text-end" id="reciboPrestamo">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Fecha límite:</span>
                    <span class="col-6 text-end" id="reciboVencimiento">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Días de retraso:</span>
                    <span class="col-6 text-end text-danger fw-bold" id="reciboDias">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Tarifa diaria:</span>
                    <span class="col-6 text-end" id="reciboTarifa">-</span>
                </div>
                <div class="row pt-2 border-top">
                    <span class="col-6 fs-5 fw-bold">Importe de multa:</span>
                    <span class="col-6 fs-5 fw-bold text-end text-success" id="reciboMonto">-</span>
                </div>
                <div class="row mt-2">
                    <span class="col-6 text-muted">Estado:</span>
                    <span class="col-6 text-end fw-semibold" id="reciboEstado">Pendiente</span>
                </div>
                <div class="text-center mt-3 text-muted">
                    <small id="reciboFecha"></small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="location.reload()">Cerrar</button>
                <button type="button" class="btn btn-success" id="confirmReturnBtn" style="display:none;" onclick="confirmReturn()">
                    <i class="bi bi-check2-circle me-1"></i> Confirmar Devolución
                </button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Imprimir Recibo
                </button>
            </div>
        </div>
    </div>
 </div>

@* Mostrar modal tanto si TempData contiene el JSON (legacy) como si PageModel.LastReturnResult fue poblado *@
@if (TempData["ReturnResult"] != null || Model.LastReturnResult != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            try {
                var data = null;
                if (@(Model.LastReturnResult != null ? "true" : "false")) {
                    data = {
                        receiptNumber: '@(Model.LastReturnResult?.ReceiptNumber ?? "-")',
                        borrowerName: '@(Model.LastReturnResult?.BorrowerName ?? "-")',
                        bookTitle: '@(Model.LastReturnResult?.BookTitle ?? "-")',
                        overdueDays: @(Model.LastReturnResult?.OverdueDays ?? 0),
                        amount: @(Model.LastReturnResult?.Amount ?? 0),
                        paidAt: '@(Model.LastReturnResult?.PaidAt?.ToString("o") ?? string.Empty)',
                        dailyRate: @(Model.LastReturnResult?.DailyRate ?? 0),
                        dueDate: '@(Model.LastReturnResult?.DueDate?.ToString("o") ?? string.Empty)',
                        loanId: @(Model.LastReturnResult?.LoanId ?? 0),
                        fineStatus: '@(Model.LastReturnResult?.FineStatus ?? "Pending")'
                    };
                    // Mostrar y configurar el botón confirmar cuando el preview viene del servidor
                    var confirmBtn = document.getElementById('confirmReturnBtn');
                    if (confirmBtn) {
                        confirmBtn.style.display = 'inline-block';
                        confirmBtn.dataset.copyId = @(Model.LastReturnResult?.CopyId ?? 0);
                    }
                } else {
                    data = @Html.Raw(TempData["ReturnResult"]);
                }

                document.getElementById('reciboNumero').innerText = data.receiptNumber ?? '-';
                document.getElementById('reciboLector').innerText = data.borrowerName ?? '-';
                document.getElementById('reciboLibro').innerText = data.bookTitle ?? '-';
                document.getElementById('reciboDias').innerText = data.overdueDays ?? '-';
                document.getElementById('reciboMonto').innerText = 'Bs. ' + Number(data.amount).toFixed(2);
                document.getElementById('reciboPrestamo').innerText = data.loanId ?? '-';
                document.getElementById('reciboVencimiento').innerText = data.dueDate ? new Date(data.dueDate).toLocaleDateString('es-BO') : '-';
                document.getElementById('reciboTarifa').innerText = data.dailyRate ? 'Bs. ' + Number(data.dailyRate).toFixed(2) : '-';
                document.getElementById('reciboEstado').innerText = data.fineStatus ?? 'Pendiente';
                document.getElementById('reciboFecha').innerText = data.paidAt ? new Date(data.paidAt).toLocaleString('es-BO') : new Date().toLocaleString('es-BO');
                var modal = new bootstrap.Modal(document.getElementById('reciboModal'));
                modal.show();
            } catch (e) { console.error('Error parsing ReturnResult', e); }
        });
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Called from the return button next to each loan item
        window.returnCopy = async function (copyId, titulo) {
            console.log('returnCopy called', copyId, titulo);
            if (!confirm('¿Confirmar la devolución del libro "' + titulo + '"?')) {
                return;
            }

            try {
                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                // Step 1: Preview - check if there will be a fine (confirm=false)
                const previewUrl = window.location.pathname + '?handler=ReturnItem&confirm=false';
                const formData = new FormData();
                formData.append('copyId', copyId);
                if (token) formData.append('__RequestVerificationToken', token);

                const previewResponse = await fetch(previewUrl, {
                    method: 'POST',
                    body: formData
                });

                if (!previewResponse.ok) {
                    const txt = await previewResponse.text();
                    alert('Error: ' + txt);
                    return;
                }

                const previewData = await previewResponse.json();

                if (data.hasFine) {
                    document.getElementById('reciboNumero').innerText = data.receiptNumber ?? '-';
                    document.getElementById('reciboLector').innerText = data.borrowerName ?? '-';
                    document.getElementById('reciboLibro').innerText = data.bookTitle ?? '-';
                    document.getElementById('reciboDias').innerText = data.overdueDays ?? '-';
                    document.getElementById('reciboMonto').innerText = 'Bs. ' + Number(data.amount).toFixed(2);
                    document.getElementById('reciboPrestamo').innerText = data.loanId ?? '-';
                    document.getElementById('reciboVencimiento').innerText = data.dueDate ? new Date(data.dueDate).toLocaleDateString('es-BO') : '-';
                    document.getElementById('reciboTarifa').innerText = data.dailyRate ? 'Bs. ' + Number(data.dailyRate).toFixed(2) : '-';
                    document.getElementById('reciboEstado').innerText = data.fineStatus ?? 'Pendiente';
                    document.getElementById('reciboFecha').innerText = data.paidAt ? new Date(data.paidAt).toLocaleString('es-BO') : new Date().toLocaleString('es-BO');

                    const confirmBtn = document.getElementById('confirmReturnBtn');
                    if (confirmBtn) confirmBtn.style.display = 'none';
                    const modalElement = document.getElementById('reciboModal');
                    modalElement.addEventListener('hidden.bs.modal', () => location.reload(), { once: true });
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                } else {
                    // No fine - confirm directly (persist)
                    await confirmReturnDirect(copyId);
                }
            } catch (err) {
                alert('Ocurrió un error inesperado al procesar la devolución.');
                console.error(err);
            }
        }

        // Direct confirmation without fine (or after user clicks confirm in modal)
        async function confirmReturnDirect(copyId) {
            try {
                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                const formData = new FormData();
                formData.append('copyId', copyId);
                if (token) formData.append('__RequestVerificationToken', token);

                const url = window.location.pathname + '?handler=ConfirmReturnItem';

                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    body: formData
                });

                if (!response.ok) {
                    const txt = await response.text();
                    alert('Error al confirmar la devolución: ' + txt);
                    return;
                }

                const data = await response.json();
                if (data.hasFine) {
                    // This shouldn't happen in direct confirm, but handle it
                    alert('Multa registrada y devolución confirmada.');
                } else {
                    alert(data.message || 'Devolución confirmada.');
                }
                location.reload();
            } catch (e) {
                alert('Error inesperado al confirmar la devolución.');
                console.error(e);
            }
        }

        // Called from modal to confirm and persist the return when a fine exists
        async function confirmReturn() {
            try {
                const btn = document.getElementById('confirmReturnBtn');
                const copyId = btn.dataset.copyId;
                await confirmReturnDirect(copyId);
            } catch (e) {
                alert('Error inesperado al confirmar la devolución.');
                console.error(e);
            }
        }
    </script>
}

@Html.AntiForgeryToken()

<div class="container content-wrapper">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="page-title mb-0">
                    <i class="bi bi-journal-text me-2"></i>
                    Detalle de Préstamo @Model.Loan?.Id
                </h2>
                <p class="text-muted mb-0">
                    Información completa del préstamo y sus ítems
                </p>
            </div>

            <div class="d-flex gap-2">
                @if (Model.Loan != null)
                {
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEditarPrestamo">
                        <i class="bi bi-pencil-square me-2"></i>
                        Modificar Préstamo
                    </button>
                }

                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>
                    Volver a Préstamos
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (Model.Loan == null)
        {
            <div class="text-center py-5">
                <i class="bi bi-exclamation-circle display-1 text-warning"></i>
                <h4 class="mt-3">Préstamo no encontrado</h4>
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="border-bottom pb-2">Información del Préstamo</h5>
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9"><code>@Model.Loan.Id</code></dd>

                        <dt class="col-sm-3">Lector</dt>
                        <dd class="col-sm-9">@Model.Loan.BorrowerName (ID: @Model.Loan.BorrowerId)</dd>

                        <dt class="col-sm-3">Bibliotecario</dt>
                        <dd class="col-sm-9">@Model.Loan.LibrarianName (ID: @Model.Loan.LibrarianId)</dd>

                        <dt class="col-sm-3">Fecha de préstamo</dt>
                        <dd class="col-sm-9">@Model.Loan.LoanDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Fecha de vencimiento</dt>
                        <dd class="col-sm-9">
                            <span class="fw-semibold">@Model.Loan.DueDate.ToString("dd/MM/yyyy")</span>
                        </dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">
                            @{
                                var badgeClass = Model.Loan.Status switch
                                {
                                    "Active" => "bg-primary",
                                    "Completed" => "bg-success",
                                    "Overdue" => "bg-danger",
                                    "Lost" => "bg-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass fs-6 px-3 py-2">
                                @Model.Loan.StatusDisplayName
                            </span>
                        </dd>

                        <dt class="col-sm-3">Creado</dt>
                        <dd class="col-sm-9">@Model.Loan.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Actualizado</dt>
                        <dd class="col-sm-9">@(Model.Loan.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h5 class="border-bottom pb-2">Resumen de Ítems</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Total de ítems</dt>
                        <dd class="col-sm-8"><strong>@Model.Loan.Items.Count</strong></dd>

                        <dt class="col-sm-4">Devueltos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">@Model.Loan.Items.Count(i => i.Status == "Returned")</span>
                        </dd>

                        <dt class="col-sm-4">Activos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.Loan.Items.Count(i => i.Status == "Active")</span>
                        </dd>

                        <dt class="col-sm-4">Vencidos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger">@Model.Loan.Items.Count(i => i.Status == "Overdue")</span>
                        </dd>

                        <dt class="col-sm-4">Perdidos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-dark">@Model.Loan.Items.Count(i => i.Status == "Lost")</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <hr />

            <h5 class="mb-3">Ítems del Préstamo</h5>

            @if (Model.Loan.Items.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Este préstamo no tiene ítems registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Copia</th>
                                <th>Libro</th>
                                <th>Estado</th>
                        <th class="text-center">Fecha devolución</th>
                        <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Loan.Items)
                            {
                                <tr>
                                    <td>
                                        <code>@item.InternalCode</code>
                                        <br />
                                        <small class="text-muted">ID: @item.CopyId</small>
                                    </td>
                                    <td>
                                        <strong>@item.BookTitle</strong>
                                        <br />
                                        <small class="text-muted">ID: @item.BookId</small>
                                    </td>
                                    <td>
                                        @{
                                            var itemBadgeClass = item.Status switch
                                            {
                                                "Active" => "bg-primary",
                                                "Returned" => "bg-success",
                                                "Overdue" => "bg-danger",
                                                "Lost" => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @itemBadgeClass">
                                            @item.StatusDisplayName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @(item.ReturnedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == "Active" || item.Status == "Overdue")
                                        {
                                            <button type="button" class="btn btn-success btn-sm" onclick="returnCopy(@item.CopyId, '@item.BookTitle.Replace("'", "\\'")')">
                                                <i class="bi bi-arrow-return-left me-1"></i> Devolver
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<!-- Modal para Modificar Estado y Fecha de Vencimiento -->
@if (Model.Loan != null)
{
    <div class="modal fade" id="modalEditarPrestamo" tabindex="-1" aria-labelledby="modalEditarPrestamoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateLoan">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalEditarPrestamoLabel">
                            <i class="bi bi-calendar-event me-2"></i>Modificar Préstamo #@Model.Loan.Id
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="EditDueDate" class="form-label fw-semibold">Nueva Fecha de Vencimiento</label>
                            <input asp-for="EditDueDate" type="date" class="form-control" required />
                            <small class="text-muted">Extiende la fecha límite de entrega del libro.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditStatus" class="form-label fw-semibold">Estado del Préstamo</label>
                            <select asp-for="EditStatus" class="form-select" required>
                                <option value="Active">Activo</option>
                                <option value="Completed">Completado</option>
                                <option value="Overdue">Vencido</option>
                                <option value="Lost">Perdido</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
