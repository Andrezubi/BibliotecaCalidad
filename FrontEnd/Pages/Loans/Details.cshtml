@page "{id}"
@model FrontEnd.Pages.Loans.DetailsModel
@inject FrontEnd.Services.FinePaymentIdProtector PaymentIdProtector

@{
    ViewData["Title"] = "Detalle de Préstamo";
}

<style>
    /* Confirmaciones y notificaciones integradas con el tema oscuro. */
    .loan-confirm-modal .modal-content {
        background: #1d2026;
        color: #f8f9fa;
        border: 1px solid #454854;
        border-radius: 1rem;
        box-shadow: 0 18px 60px rgba(0, 0, 0, .4);
    }

    .loan-confirm-modal .modal-header,
    .loan-confirm-modal .modal-footer {
        border-color: #3c4049;
    }

    .loan-confirm-modal .text-muted {
        color: #b7bdc8 !important;
    }

    .loan-toast {
        background: #1d2026;
        color: #f8f9fa;
        border: 1px solid #454854;
        border-left: 4px solid #6f63ff;
        border-radius: .75rem;
        box-shadow: 0 10px 35px rgba(0, 0, 0, .32);
        max-width: min(420px, calc(100vw - 2rem));
    }

    .loan-toast-success {
        border-left-color: #25b778;
    }

    .loan-toast-danger {
        border-left-color: #f06b74;
    }

    .loan-toast .btn-close {
        filter: invert(1) grayscale(100%);
    }

    .loan-toast .toast-body {
        overflow-wrap: anywhere;
    }
</style>

<!-- Vista previa de multa ANTES de confirmar la devolución: NO es un recibo de pago. -->
<div class="modal fade" id="reciboModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-circle me-2"></i>Vista previa de multa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="location.reload()"></button>
            </div>
            <div class="modal-body p-4" id="areaImpresion">
                <div class="text-center mb-3">
                    <h4 class="fw-bold mb-0">Sistema de Biblioteca</h4>
                    <small class="text-muted">Estimación antes de confirmar la devolución</small>
                </div>
                <hr />
                <div class="row mb-2">
                    <span class="col-6 text-muted">Lector:</span>
                    <span class="col-6 text-end fw-semibold" id="reciboLector">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Libro:</span>
                    <span class="col-6 text-end" id="reciboLibro">-</span>
                </div>
                <div class="row mb-2">
                    <span class="col-6 text-muted">Días de retraso:</span>
                    <span class="col-6 text-end text-danger fw-bold" id="reciboDias">-</span>
                </div>
                <div class="row pt-2 border-top">
                    <span class="col-6 fs-5 fw-bold">Multa estimada:</span>
                    <span class="col-6 fs-5 fw-bold text-end text-danger" id="reciboMonto">-</span>
                </div>
                <div class="text-center mt-3 text-muted">
                    <small>Esta vista previa no representa un pago. El recibo PDF solo se emite después del cobro.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="location.reload()">Cerrar</button>
                <button type="button" class="btn btn-success" id="confirmReturnBtn" style="display:none;" onclick="confirmReturn()">
                    <i class="bi bi-check2-circle me-1"></i> Confirmar Devolución
                </button>
            </div>
        </div>
    </div>

</div>


<!-- Confirmación de devolución: sustituye el diálogo nativo del navegador. -->
<div class="modal fade loan-confirm-modal" id="modalConfirmarDevolucion" tabindex="-1"
     aria-labelledby="tituloConfirmarDevolucion" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloConfirmarDevolucion">
                    <i class="bi bi-arrow-return-left me-2 text-success"></i>Confirmar devolución
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Deseas registrar la devolución de este libro?</p>
                <p class="fw-semibold mb-2" id="libroADevolver"></p>
                <small class="text-muted">Antes de guardar, el sistema comprobará si corresponde una multa.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="aceptarDevolucionBtn">
                    <i class="bi bi-check2-circle me-1"></i>Continuar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmación de cobro: el formulario POST solo se envía al confirmar. -->
<div class="modal fade loan-confirm-modal" id="modalConfirmarPago" tabindex="-1"
     aria-labelledby="tituloConfirmarPago" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="PayFine" asp-route-id="@Model.Id" id="formConfirmarPago">
                <input type="hidden" name="fineId" id="multaACobrarId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloConfirmarPago">
                        <i class="bi bi-cash-coin me-2 text-warning"></i>Confirmar pago de multa
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">¿Confirmas que recibiste el pago de esta multa?</p>
                    <div class="border rounded p-3">
                        <div class="small text-muted">Libro</div>
                        <div class="fw-semibold mb-3" id="libroMultaPago">-</div>
                        <div class="small text-muted">Importe a cobrar</div>
                        <div class="fs-4 fw-bold text-warning" id="importeMultaPago">-</div>
                    </div>
                    <small class="text-muted d-block mt-3">
                        Al confirmar, se guardará el pago y podrás descargar su recibo PDF.
                    </small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" id="aceptarPagoBtn">
                        <i class="bi bi-check2-circle me-1"></i>Confirmar pago
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Notificaciones dentro de la aplicación, sin ventanas "localhost dice". -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    @if (TempData["Success"] is string successMessage)
    {
        <div class="toast loan-toast loan-toast-success loan-auto-toast mb-2" role="status"
             aria-live="polite" data-bs-delay="8000">
            <div class="d-flex align-items-start">
                <div class="toast-body flex-grow-1">
                    <strong class="d-block mb-1"><i class="bi bi-check-circle me-1"></i>Operación realizada</strong>
                    @successMessage
                    @if (TempData["PaymentReceiptToken"] is string receiptToken)
                    {
                        <div class="mt-2">
                            <a asp-page="/Loans/Index" asp-page-handler="Receipt"
                               asp-route-receipt="@receiptToken" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-file-earmark-pdf me-1"></i>Descargar recibo PDF
                            </a>
                        </div>
                    }
                </div>
                <button type="button" class="btn-close m-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] is string serverErrorMessage)
    {
        <div class="toast loan-toast loan-toast-danger loan-auto-toast mb-2" role="alert"
             aria-live="assertive" data-bs-autohide="false">
            <div class="d-flex align-items-start">
                <div class="toast-body flex-grow-1">
                    <strong class="d-block mb-1"><i class="bi bi-exclamation-triangle me-1"></i>No se pudo completar</strong>
                    @serverErrorMessage
                </div>
                <button type="button" class="btn-close m-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    }
    <div class="toast loan-toast" id="loanClientToast" role="status" aria-live="polite"
         data-bs-delay="6500">
        <div class="d-flex align-items-start">
            <div class="toast-body flex-grow-1">
                <strong class="d-block mb-1" id="loanToastTitle">Notificación</strong>
                <span id="loanToastMessage"></span>
            </div>
            <button type="button" class="btn-close m-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const returnDialogElement = document.getElementById('modalConfirmarDevolucion');
            const returnDialog = bootstrap.Modal.getOrCreateInstance(returnDialogElement);
            const previewDialog = bootstrap.Modal.getOrCreateInstance(document.getElementById('reciboModal'));
            const payDialog = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalConfirmarPago'));
            const returnButton = document.getElementById('aceptarDevolucionBtn');
            const previewConfirmButton = document.getElementById('confirmReturnBtn');
            const clientToastElement = document.getElementById('loanClientToast');
            const clientToast = bootstrap.Toast.getOrCreateInstance(clientToastElement);
            const flashKey = 'biblioteca:prestamo:devolucion';
            let pendingCopyId = null;
            let isReturning = false;

            function showNotice(message, kind = 'success') {
                clientToastElement.classList.remove('loan-toast-success', 'loan-toast-danger');
                clientToastElement.classList.add(kind === 'danger' ? 'loan-toast-danger' : 'loan-toast-success');
                clientToastElement.setAttribute('role', kind === 'danger' ? 'alert' : 'status');
                document.getElementById('loanToastTitle').textContent =
                    kind === 'danger' ? 'No se pudo completar' : 'Operación realizada';
                document.getElementById('loanToastMessage').textContent = message;
                clientToast.show();
            }

            // Mostrar notificaciones generadas tras un POST normal (pago/modificación).
            document.querySelectorAll('.loan-auto-toast').forEach(element => {
                bootstrap.Toast.getOrCreateInstance(element).show();
            });

            // Conservar el mensaje de devolución después de actualizar la lista de ítems.
            try {
                const flash = JSON.parse(sessionStorage.getItem(flashKey) || 'null');
                if (flash && flash.path === window.location.pathname) {
                    sessionStorage.removeItem(flashKey);
                    showNotice(flash.message);
                }
            } catch (error) {
                console.debug('No se pudo recuperar la notificación temporal.', error);
            }

            function showSuccessAndRefresh(message) {
                try {
                    sessionStorage.setItem(flashKey, JSON.stringify({
                        path: window.location.pathname,
                        message: message
                    }));
                    window.location.reload();
                } catch {
                    // Fallback si el navegador bloquea sessionStorage.
                    showNotice(message);
                    setTimeout(() => window.location.reload(), 2000);
                }
            }

            async function responseError(response) {
                try {
                    const payload = await response.json();
                    return payload.message || payload.title || `Error HTTP ${response.status}`;
                } catch {
                    return `Error HTTP ${response.status}. Intenta nuevamente.`;
                }
            }

            async function sendReturn(copyId, confirm) {
                const formData = new FormData();
                formData.append('copyId', String(copyId));
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) formData.append('__RequestVerificationToken', token.value);

                const url = window.location.pathname + '?handler=ReturnItem&confirm=' + String(confirm);
                const response = await fetch(url, { method: 'POST', body: formData });
                if (!response.ok) throw new Error(await responseError(response));
                return await response.json();
            }

            // Botón Devolver: primero pide confirmación dentro de la aplicación.
            window.returnCopy = (copyId, title) => {
                if (isReturning) return;
                pendingCopyId = copyId;
                document.getElementById('libroADevolver').textContent = title || 'Libro seleccionado';
                returnDialog.show();
            };

            returnButton.addEventListener('click', () => {
                if (pendingCopyId == null || isReturning) return;
                const copyId = pendingCopyId;
                pendingCopyId = null;
                // Esperar a que cierre el primer modal antes de mostrar la vista previa.
                returnDialogElement.addEventListener('hidden.bs.modal', () => previewReturn(copyId), { once: true });
                returnDialog.hide();
            });

            async function previewReturn(copyId) {
                if (isReturning) return;
                isReturning = true;
                try {
                    const preview = await sendReturn(copyId, false);
                    if (preview.hasFine) {
                        document.getElementById('reciboLector').textContent = preview.borrowerName || '-';
                        document.getElementById('reciboLibro').textContent = preview.bookTitle || '-';
                        document.getElementById('reciboDias').textContent = preview.overdueDays ?? '-';
                        document.getElementById('reciboMonto').textContent =
                            'Bs ' + Number(preview.amount || 0).toFixed(2);
                        previewConfirmButton.dataset.copyId = String(copyId);
                        previewConfirmButton.style.display = 'inline-block';
                        previewDialog.show();
                    } else if (preview.message === 'Devolución sin multa.') {
                        await confirmReturnDirect(copyId);
                    } else {
                        showNotice(preview.message || 'No se pudo verificar la devolución.', 'danger');
                    }
                } catch (error) {
                    console.error('Error al consultar devolución:', error);
                    showNotice(error.message || 'No se pudo consultar la devolución.', 'danger');
                } finally {
                    isReturning = false;
                }
            }

            async function confirmReturnDirect(copyId) {
                if (previewConfirmButton.disabled) return;
                previewConfirmButton.disabled = true;
                try {
                    const result = await sendReturn(copyId, true);
                    if (!result.message || !result.message.startsWith('Devolución registrada')) {
                        showNotice(result.message || 'No se pudo registrar la devolución.', 'danger');
                        return;
                    }
                    const message = result.hasFine
                        ? 'Multa registrada y devolución confirmada.'
                        : 'Devolución registrada correctamente.';
                    showSuccessAndRefresh(message);
                } catch (error) {
                    console.error('Error al confirmar devolución:', error);
                    showNotice(error.message || 'No se pudo confirmar la devolución.', 'danger');
                } finally {
                    previewConfirmButton.disabled = false;
                }
            }

            // El botón del modal de multa reutiliza la misma confirmación persistente.
            window.confirmReturn = () => {
                const copyId = Number(previewConfirmButton.dataset.copyId);
                if (copyId > 0) confirmReturnDirect(copyId);
            };

            // Preparar confirmación de pago sin diálogos nativos del navegador.
            document.querySelectorAll('.js-pay-fine').forEach(button => {
                button.addEventListener('click', () => {
                    document.getElementById('multaACobrarId').value = button.dataset.fineId;
                    document.getElementById('libroMultaPago').textContent = button.dataset.bookTitle || '-';
                    document.getElementById('importeMultaPago').textContent = 'Bs ' + (button.dataset.amount || '-');
                    payDialog.show();
                });
            });

            document.getElementById('formConfirmarPago').addEventListener('submit', () => {
                const button = document.getElementById('aceptarPagoBtn');
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Registrando...';
            });
        })();
    </script>
}

@Html.AntiForgeryToken()

<div class="container content-wrapper">
    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="page-title mb-0">
                    <i class="bi bi-journal-text me-2"></i>
                    Detalle de Préstamo
                </h2>
                <p class="text-muted mb-0">
                    Información completa del préstamo y sus ítems
                </p>
            </div>

            <div class="d-flex gap-2">
                @if (Model.Loan != null)
                {
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEditarPrestamo">
                        <i class="bi bi-pencil-square me-2"></i>
                        Modificar Préstamo
                    </button>
                }

                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>
                    Volver a Préstamos
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        else if (Model.Loan == null)
        {
            <div class="text-center py-5">
                <i class="bi bi-exclamation-circle display-1 text-warning"></i>
                <h4 class="mt-3">Préstamo no encontrado</h4>
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="border-bottom pb-2">Información del Préstamo</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Lector</dt>
                        <dd class="col-sm-9">@Model.Loan.BorrowerName</dd>

                        <dt class="col-sm-3">Bibliotecario</dt>
                        <dd class="col-sm-9">@Model.Loan.LibrarianName</dd>

                        <dt class="col-sm-3">Fecha de préstamo</dt>
                        <dd class="col-sm-9">@Model.Loan.LoanDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Fecha de vencimiento</dt>
                        <dd class="col-sm-9">
                            <span class="fw-semibold">@Model.Loan.DueDate.ToString("dd/MM/yyyy")</span>
                        </dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">
                            @{
                                var badgeClass = Model.Loan.Status switch
                                {
                                    "Active" => "bg-primary",
                                    "Completed" => "bg-success",
                                    "Overdue" => "bg-danger",
                                    "Lost" => "bg-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass fs-6 px-3 py-2">
                                @Model.Loan.StatusDisplayName
                            </span>
                        </dd>

                        <dt class="col-sm-3">Creado</dt>
                        <dd class="col-sm-9">@Model.Loan.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Actualizado</dt>
                        <dd class="col-sm-9">@(Model.Loan.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h5 class="border-bottom pb-2">Resumen de Ítems</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Total de ítems</dt>
                        <dd class="col-sm-8"><strong>@Model.Loan.Items.Count</strong></dd>

                        <dt class="col-sm-4">Devueltos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">@Model.Loan.Items.Count(i => i.Status == "Returned")</span>
                        </dd>

                        <dt class="col-sm-4">Activos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.Loan.Items.Count(i => i.Status == "Active")</span>
                        </dd>

                        <dt class="col-sm-4">Vencidos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger">@Model.Loan.Items.Count(i => i.Status == "Overdue")</span>
                        </dd>

                        <dt class="col-sm-4">Perdidos</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-dark">@Model.Loan.Items.Count(i => i.Status == "Lost")</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <hr />

            <h5 class="mb-3">Ítems del Préstamo</h5>

            @if (Model.Loan.Items.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Este préstamo no tiene ítems registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Copia</th>
                                <th>Libro</th>
                                <th>Estado</th>
                                <th class="text-center">Fecha devolución</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Loan.Items)
                            {
                                <tr>
                                    <td>
                                        <code>@item.InternalCode</code>

                                    </td>
                                    <td>
                                        <strong>@item.BookTitle</strong>

                                    </td>
                                    <td>
                                        @{
                                            var itemBadgeClass = item.Status switch
                                            {
                                                "Active" => "bg-primary",
                                                "Returned" => "bg-success",
                                                "Overdue" => "bg-danger",
                                                "Lost" => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @itemBadgeClass">
                                            @item.StatusDisplayName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @(item.ReturnedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == "Active" || item.Status == "Overdue")
                                        {
                                            <button type="button" class="btn btn-success btn-sm" data-title="@item.BookTitle" onclick="returnCopy(@item.CopyId, this.dataset.title)">
                                                <i class="bi bi-arrow-return-left me-1"></i> Devolver
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Multas reales registradas y estimaciones (sin cobro). -->
            <section id="multas" class="mt-4 pt-3 border-top">
                <h5 class="mb-3"><i class="bi bi-cash-coin me-2"></i>Multas del préstamo</h5>
                @if (!string.IsNullOrEmpty(Model.FineError))
                {
                    <div class="alert alert-warning">@Model.FineError</div>
                }
                else if (Model.FineDetails == null || Model.FineDetails.Fines.Count == 0)
                {
                    <div class="alert alert-info">Este préstamo no tiene multas registradas ni estimadas.</div>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <small class="text-muted">Pendiente de pago</small>
                                <div class="fs-5 fw-bold text-danger">Bs @Model.FineDetails.TotalPending.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <small class="text-muted">Pagado</small>
                                <div class="fs-5 fw-bold text-success">Bs @Model.FineDetails.TotalPaid.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <small class="text-muted">Estimado, aún no registrado</small>
                                <div class="fs-5 fw-bold text-warning">Bs @Model.FineDetails.TotalEstimated.ToString("0.00")</div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Libro</th>
                                    <th>Días hábiles</th>
                                    <th>Tarifa diaria</th>
                                    <th>Multa</th>
                                    <th>Saldo</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fine in Model.FineDetails.Fines)
                                {
                                    <tr>
                                        <td><strong>@fine.BookTitle</strong></td>
                                        <td>@fine.OverdueDays</td>
                                        <td>Bs @fine.DailyRate.ToString("0.00")</td>
                                        <td>Bs @fine.Amount.ToString("0.00")</td>
                                        <td>Bs @fine.PendingAmount.ToString("0.00")</td>
                                        <td>
                                            @if (fine.Status == "Estimated")
                                            {
                                                <span class="badge bg-warning text-dark">Estimación</span>
                                            }
                                            else if (fine.Status == "Waived")
                                            {

                                                <span class="badge bg-secondary">Condonada</span>
                                            }
                                            else if (fine.PendingAmount > 0)
                                            {

                                                <span class="badge bg-danger">Pendiente</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-success">Pagada</span>
                                            }
                                        </td>
                                        <td>
                                            @if (fine.FineId > 0 && fine.PendingAmount > 0)
                                            {
                                                <button type="button" class="btn btn-warning btn-sm js-pay-fine"
                                                        data-fine-id="@fine.FineId"
                                                        data-book-title="@fine.BookTitle"
                                                        data-amount="@fine.PendingAmount.ToString("0.00")">
                                                    <i class="bi bi-cash-coin me-1"></i>Pagar multa
                                                </button>
                                            }
                                            @foreach (var payment in fine.Payments)
                                            {
                                                <a asp-page="/Loans/Index" asp-page-handler="Receipt"
                                                   asp-route-receipt="@PaymentIdProtector.Protect(payment.PaymentId)"
                                                   class="btn btn-outline-success btn-sm my-1"
                                                   title="@($"Recibo {payment.ReceiptNumber} - {payment.PaidAt:dd/MM/yyyy}")">
                                                    <i class="bi bi-file-earmark-pdf me-1"></i>Recibo PDF
                                                </a>
                                            }
                                            @if (fine.Status == "Estimated")
                                            {
                                                <small class="text-muted d-block">Se registra al devolver el libro.</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <small class="text-muted">
                        Los importes estimados no son deudas cobrables. El PDF se habilita solo después de registrar el pago.
                    </small>
                }
            </section>
        }
    </div>
</div>

<!-- Modal para Modificar Estado y Fecha de Vencimiento -->
@if (Model.Loan != null)
{
    <div class="modal fade" id="modalEditarPrestamo" tabindex="-1" aria-labelledby="modalEditarPrestamoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateLoan">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalEditarPrestamoLabel">
                            <i class="bi bi-calendar-event me-2"></i>Modificar Préstamo
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="EditDueDate" class="form-label fw-semibold">Nueva Fecha de Vencimiento</label>
                            <input asp-for="EditDueDate" type="date" class="form-control" required />
                            <small class="text-muted">Extiende la fecha límite de entrega del libro.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditStatus" class="form-label fw-semibold">Estado del Préstamo</label>
                            <select asp-for="EditStatus" class="form-select" required>
                                <option value="Active">Activo</option>
                                <option value="Completed">Completado</option>
                                <option value="Overdue">Vencido</option>
                                <option value="Lost">Perdido</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}