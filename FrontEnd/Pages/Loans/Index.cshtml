@page
@model FrontEnd.Pages.Loans.IndexModel
@inject FrontEnd.Services.LoanIdProtector LoanIdProtector
@inject FrontEnd.Services.FinePaymentIdProtector PaymentIdProtector

@{
    ViewData["Title"] = "Préstamos";
}

<div class="container content-wrapper">

    <div class="card-custom">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="page-title mb-0">
                    <i class="bi bi-journal-text me-2"></i>
                    Préstamos
                </h2>

                <p class="text-muted mb-0">
                    Lista de todos los préstamos registrados
                </p>

            </div>

            <div>
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Crear préstamo
                </a>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @Model.ErrorMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.FineError))
        {
            <div class="alert alert-warning">@Model.FineError</div>
        }
        @if (Model.ErrorMessage == null && Model.Loans.Count == 0)
        {
            <div class="text-center py-5">

                <i class="bi bi-journal-text display-1 text-secondary"></i>

                <h4 class="mt-3">
                    No hay préstamos registrados
                </h4>

                <p class="text-muted">
                    No se han registrado préstamos en el sistema.
                </p>

            </div>
        }
        else if (Model.ErrorMessage == null)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>

                            <th>Lector</th>

                            <th>Bibliotecario</th>

                            <th>Fecha préstamo</th>

                            <th>Fecha vencimiento</th>

                            <th class="text-center">
                                Estado
                            </th>

                            <th class="text-center">
                                Ítems
                            </th>

                            <th class="text-center">
                                Devueltos
                            </th>
                            <th class="text-center">Multa</th>

                            <th class="text-center"
                                style="min-width: 100px;">
                                Acciones
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var loan in Model.Loans)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @loan.BorrowerName
                                    </strong>
                                </td>

                                <td>
                                    @loan.LibrarianName
                                </td>

                                <td>
                                    @loan.LoanDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @loan.DueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">

                                    @{
                                        var badgeClass = loan.Status switch
                                        {
                                            "Active" => "bg-primary",
                                            "Completed" => "bg-success",
                                            "Overdue" => "bg-danger",
                                            "Lost" => "bg-dark",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @badgeClass">
                                        @loan.StatusDisplayName
                                    </span>

                                </td>

                                <td class="text-center">
                                    @loan.ItemsCount
                                </td>

                                <td class="text-center">
                                    @loan.ReturnedItemsCount
                                </td>

                                <td class="text-center">
                                    @if (Model.FineSummaries.TryGetValue(loan.Id, out var fineSummary))
                                    {
                                        if (fineSummary.PendingAmount > 0)
                                        {
                                            <span class="badge bg-danger">Bs @fineSummary.PendingAmount.ToString("0.00") pendiente</span>
                                        }
                                        else if (fineSummary.PaidAmount > 0)
                                        {
                                            <span class="badge bg-success">Pagada</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin deuda</span>
                                        }
                                    }
                                    else if (loan.Status == "Overdue")
                                    {
                                        <span class="badge bg-warning text-dark">Por calcular</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin multa</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <a asp-page="Details"
                                           asp-route-id="@LoanIdProtector.Protect(loan.Id)"
                                           class="btn btn-outline-primary btn-sm"
                                           title="Ver detalles"
                                           aria-label="Ver detalles del préstamo">

                                            <i class="bi bi-eye"></i>

                                        </a>
                                        @if (Model.FineSummaries.TryGetValue(loan.Id, out var summary) && summary.PendingAmount > 0)
                                        {
                                            <a asp-page="Details"
                                               asp-route-id="@LoanIdProtector.Protect(loan.Id)"
                                               asp-fragment="multas"
                                               class="btn btn-warning btn-sm"
                                               title="Pagar multa">
                                                <i class="bi bi-cash-coin me-1"></i>Pagar multa
                                            </a>
                                        }
                                        @if (Model.FineSummaries.TryGetValue(loan.Id, out var paidSummary) && paidSummary.LastPaymentId.HasValue)
                                        {
                                            <a asp-page-handler="Receipt"
                                               asp-route-receipt="@PaymentIdProtector.Protect(paidSummary.LastPaymentId.Value)"
                                               class="btn btn-outline-success btn-sm"
                                               title="Descargar último recibo PDF">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>Recibo
                                            </a>
                                        }
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
