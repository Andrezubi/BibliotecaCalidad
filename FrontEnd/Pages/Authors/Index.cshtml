@page
@model FrontEnd.Pages.Authors.IndexModel

@{
    ViewData["Title"] = "Autores";
}

<div class="container content-wrapper">

    <div class="card-custom">

        <!-- ===================================================== -->
        <!-- ENCABEZADO -->
        <!-- ===================================================== -->

        <div class="mb-4">

            <h1 class="page-title mb-1">
                <i class="bi bi-person-lines-fill me-2"></i>
                Autores
            </h1>

            <p class="text-muted mb-0">
                Autores disponibles en la biblioteca
            </p>

        </div>


        <!-- ===================================================== -->
        <!-- LISTA -->
        <!-- ===================================================== -->
        @if (Model.Authors.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Nombre
                            </th>

                            <th>
                                Apellido
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var author in Model.Authors)
                        {
                            <tr>

                                <td>
                                    @author.Id
                                </td>

                                <td>

                                    <strong>
                                        <i class="bi bi-person me-2"></i>
                                        @author.FirstName
                                    </strong>

                                </td>

                                <td>
                                    @author.LastName
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-person-lines-fill display-1 text-secondary"></i>

                <h4 class="mt-3">
                    No hay autores disponibles.
                </h4>

                <p class="text-muted">
                    Actualmente no existen autores activos
                    en la biblioteca.
                </p>

            </div>
        }

    </div>

</div>